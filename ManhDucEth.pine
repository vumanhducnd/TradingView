//@version=5
indicator("ManhDucCapital-ETH Trading", overlay=true, format=format.price, precision=2, max_labels_count=500, max_lines_count=500)
// =========================================================
// DISCLAIMER - ManhDucCapital
// =========================================================
// ⚠️ Chỉ báo này chỉ mang tính tham khảo
// Không phải khuyến nghị mua bán chứng khoán
// Không đảm bảo lợi nhuận
// Người dùng tự chịu trách nhiệm với quyết định đầu tư
// Kết quả quá khứ không đảm bảo hiệu suất tương lai
// =========================================================
// =========================================================
// CÀI ĐẶT CHUNG Vũ Mạnh Đức 0973124824
// =========================================================
tableSize    = input.string("small", "Cỡ chữ bảng",                 group="Cài đặt chung", options=["tiny","small","normal","large","huge"])
themeMode    = input.string("Light",  "Giao diện (Theme)",            group="Cài đặt chung", options=["Dark","Light"])
showsignals  = input.bool(true,   "Hiển thị tín hiệu Mua/Bán?",      group="Cài đặt chung")
showSR       = input.bool(true,  "Hiển thị đường Hỗ trợ/Kháng cự?", group="Cài đặt chung")
showCandlePattern = input.bool(false,    "Đọc vị nến khi gần đỉnh/đáy?",     group="Cài đặt chung",
     tooltip="Nhận diện mẫu nến đảo chiều khi giá tiếp cận vùng hỗ trợ/kháng cự")
nearThreshPct     = input.float(3.0,    "Ngưỡng gần đỉnh/đáy (%)",          group="Cài đặt chung",
     minval=0.5, maxval=10.0, step=0.5,
     tooltip="% khoảng cách từ giá đóng cửa đến hỗ trợ/kháng cự để coi là 'gần' (mặc định 3%)")
maxCandleLabels   = input.int(3,        "Số nhãn vị nến tối đa",             group="Cài đặt chung",
     minval=1, maxval=20,
     tooltip="Chỉ giữ lại N nhãn vị nến gần nhất trên biểu đồ")

// =========================================================
// CT TÍN HIỆU
// =========================================================
tradingStyle      = input.string("Ngắn hạn", "Phong cách giao dịch",
                     options=["Ngắn hạn", "Dài hạn", "Tùy chỉnh"],
                     tooltip="Ngắn hạn: ATR=7, Hệ số=2 | Dài hạn: ATR=10, Hệ số=3 | Tùy chỉnh: nhập tay bên dưới",
                     group="Tín hiệu")
Periods           = input.int(10,    "Chu kỳ ATR (chỉ dùng khi Tùy chỉnh)",   group="Tín hiệu")
src               = input.source(hl2,"Nguồn giá",                              group="Tín hiệu")
Multiplier        = input.float(3.0, "Hệ số nhân ATR (chỉ dùng khi Tùy chỉnh)", step=0.1, group="Tín hiệu")
changeATR         = input.bool(true, "Thay đổi phương pháp tính ATR?",         group="Tín hiệu")
useStrengthFilter = input.bool(false,"Lọc sức mạnh khi đảo chiều?",   group="Tín hiệu")
weakThr           = input.int(40,    "Ngưỡng YẾU (<=) cho Bán",       group="Tín hiệu", minval=0, maxval=100)
strongThr         = input.int(60,    "Ngưỡng MẠNH (>=) cho Mua",      group="Tín hiệu", minval=0, maxval=100)

// =========================================================
// EMA
// =========================================================
ema1Period = input.int(50,  "EMA 1", group="EMA", minval=1, inline="e1")
ema1Color  = input.color(color.new(#FF9800, 0), "", group="EMA", inline="e1")
ema1Show   = input.bool(true,  "Hiển thị", group="EMA", inline="e1")
ema2Period = input.int(100, "EMA 2", group="EMA", minval=1, inline="e2")
ema2Color  = input.color(color.new(#26C6DA, 0), "", group="EMA", inline="e2")
ema2Show   = input.bool(false, "Hiển thị", group="EMA", inline="e2")
ema3Period = input.int(200, "EMA 3", group="EMA", minval=1, inline="e3")
ema3Color  = input.color(color.new(#9C27B0, 0), "", group="EMA", inline="e3")
ema3Show   = input.bool(false, "Hiển thị", group="EMA", inline="e3")

// =========================================================
// BOLLINGER BAND OPTION
// =========================================================
showBB   = input.bool(false,  "Hiển thị Bollinger Band", group="Bollinger Band",
     tooltip="Cách dùng Bollinger Band:\n1. Chạm band trên → xem xét bán\n2. Chạm band dưới → xem xét mua\n3. BB co hẹp → chuẩn bị breakout")
bbLength = input.int(20,      "Chu kỳ BB",                group="Bollinger Band")
bbMult   = input.float(2.0,   "Độ lệch chuẩn BB",         group="Bollinger Band")
bbSrc    = input.source(close,"Nguồn BB",                 group="Bollinger Band")

// =========================================================
// CÀI ĐẶT BACKTEST Vũ Mạnh Đức 0973124824
// =========================================================
showHistory    = input.bool(true,  "Hiển thị bảng lịch sử giao dịch?", group="Test lịch sử")
startTime      = input.time(timestamp("2026-01-01"), "Từ ngày",           group="Test lịch sử")
useEndTime     = input.bool(false,  "Dùng ngày kết thúc?",               group="Test lịch sử")
endTime        = input.time(timestamp("2028-01-01"), "Đến ngày",          group="Test lịch sử")
showZoneLines  = input.bool(true,   "Hiển thị đường dọc vùng backtest?", group="Test lịch sử")
maxHistoryRows = input.int(20,      "Số lệnh hiển thị",                  group="Test lịch sử", minval=5, maxval=20)
dirFilter      = input.string("Tất cả", "Lọc lệnh hiển thị",             group="Test lịch sử", options=["Tất cả", "LONG", "SHORT"])
tablePosition  = input.string("bottom_right", "Vị trí bảng lịch sử",     group="Test lịch sử",
     options=["bottom_left","bottom_center","bottom_right"])
entryMode      = input.string("Lý tưởng nhất", "Kiểu điểm Mua/Bán",      group="Test lịch sử",
     options=["Lý tưởng nhất","Lý tưởng","Thực tế"],
     tooltip="Lý tưởng nhất: Mua đáy (Low), Bán đỉnh (High) cây nến tín hiệu\nLý tưởng: Mua/Bán trung bình đỉnh-đáy (HL2) cây nến tín hiệu\nThực tế: Mua đỉnh (High), Bán đáy (Low) cây nến tín hiệu")

// =========================================================
// CÀI ĐẶT TP / SL Vũ Mạnh Đức 0973124824
// =========================================================
showTPSL  = input.bool(true,  "Hiển thị đường TP/SL?",          group="TP / SL",
     tooltip="Vẽ đường ngang thể hiện điểm vào lệnh, cắt lỗ và các mục tiêu chốt lời\nChỉ hiển thị khi đang có lệnh MUA (trend tăng)\nTự động xóa khi xuất hiện tín hiệu Bán")
slAtrMult = input.float(1.5,  "SL Buffer (×ATR)",               group="TP / SL", minval=0.3, maxval=5.0,  step=0.1,
     tooltip="SL đặt dưới Pivot Low một khoảng = slMult × ATR\nGiá trị lớn hơn = SL rộng hơn, ít bị quét hơn\nVí dụ: 1.5 × ATR dưới pivot low gần nhất")
pivotLen  = input.int(10,     "Độ dài Pivot (bars)",             group="TP / SL", minval=3, maxval=50,
     tooltip="Số nến dùng để xác định Pivot Low làm vùng SL\nLớn hơn = pivot xa hơn, SL ổn định hơn")
tp1R      = input.float(1.0,  "TP1 (R-multiple)",                group="TP / SL", minval=0.5, maxval=10.0, step=0.1,
     tooltip="TP1 = Vào lệnh + Risk × R1\nRisk = khoảng cách từ entry đến SL (tự tính theo ATR + pivot)")
tp2R      = input.float(2.0,  "TP2 (R-multiple)",                group="TP / SL", minval=0.5, maxval=10.0, step=0.1,
     tooltip="TP2 = Vào lệnh + Risk × R2\nGợi ý chốt thêm 30–40% vị thế khi chạm")
tp3R      = input.float(3.0,  "TP3 (R-multiple)",                group="TP / SL", minval=0.5, maxval=10.0, step=0.1,
     tooltip="TP3 = Vào lệnh + Risk × R3\nGợi ý gồng phần còn lại đến mục tiêu xa nhất")
autoTPSL     = input.bool(false, "Tự động TP/SL từ lịch sử?",    group="TP / SL",
     tooltip="Tự động tính SL/TP từ % lỗ/lãi trung bình của N lệnh gần nhất trong backtest\nFallback sang ATR+pivot nếu chưa đủ ≥ 3 lệnh cùng hướng")
autoLookback = input.int(20,    "Số lệnh tham chiếu (Auto TP/SL)", group="TP / SL", minval=5, maxval=50,
     tooltip="Số lệnh gần nhất dùng để tính SL/TP tự động (chỉ tính lệnh cùng hướng)")

// =========================================================
// HÀM TIỆN ÍCH Vũ Mạnh Đức 0973124824
// =========================================================
f_pad(v)        => v < 10 ? "0" + str.tostring(v) : str.tostring(v)
f_price(p)      => p < 10000 ? str.tostring(math.round(p * 100) / 100, "#.##") : str.tostring(math.round(p / 10) / 100, "#,###.##")
f_million(v)    => str.tostring(math.round(v * 100) / 100, "#,###.##")
f_sign(v)       => v >= 0 ? "+" : ""
f_buyPrice(md)  => md == "Lý tưởng nhất" ? low  : md == "Lý tưởng" ? hl2  : high
f_sellPrice(md) => md == "Lý tưởng nhất" ? high : md == "Lý tưởng" ? hl2  : low
f_modeLabel(md) => md == "Lý tưởng nhất" ? "🏆 Lý tưởng nhất" : md == "Lý tưởng" ? "⭐ Lý tưởng" : "📊 Thực tế"
f_round2(v)     => math.round(v * 100) / 100
f_pct(v)        => f_sign(v) + str.tostring(f_round2(v)) + "%"
f_today()       => f_pad(dayofmonth) + "/" + f_pad(month) + "/" + str.tostring(year)
f_tsize(s)      => s == "tiny" ? size.tiny : s == "small" ? size.small : s == "normal" ? size.normal : s == "large" ? size.large : size.huge

// =========================================================
// PALETTE Vũ Mạnh Đức 0973124824
// =========================================================
isDark   = themeMode == "Dark"
T_BG_DRK = isDark ? color.new(#1a1a1a, 5)  : color.new(#FFFFFF, 5)
T_BG_LGT = isDark ? color.new(#2a2a2a, 5)  : color.new(#F5F5F5, 5)
T_BG_TOT = isDark ? color.new(#1e3a5f, 0)  : color.new(#D6E9FF, 0)
T_HDR    = color.new(#2196F3, 0)
T_WHT    = color.new(#FFFFFF, 0)
T_LBL    = isDark ? color.new(#E0E0E0, 0)  : color.new(#444444, 0)
T_VAL    = isDark ? color.new(#FFFFFF, 0)  : color.new(#111111, 0)
T_YLW    = isDark ? color.new(#FFC107, 0)  : color.new(#B8860B, 0)
T_GRN    = color.new(#4CAF50, 0)
T_RED    = color.new(#F44336, 0)
T_BRD    = color.new(#2196F3, 0)

// =========================================================
// CHỈ BÁO KỸ THUẬT Vũ Mạnh Đức 0973124824
// =========================================================
ema9         = ta.ema(close, 9)
ema21        = ta.ema(close, 21)
vwapV        = ta.vwap(hlc3)
rsiVal       = ta.ema(ta.rsi(close, 14), 3)
[m, s, _]    = ta.macd(close, 12, 26, 9)
[_, _, adx]  = ta.dmi(14, 14)
volAvg       = ta.sma(volume, 20)
obvVal       = ta.obv
obvEma       = ta.ema(obvVal, 10)
stK          = ta.stoch(close, high, low, 14)
stD          = ta.sma(stK, 3)
stKSmooth    = ta.ema(stK, 3)
macdHist     = m - s
macdHistPrev = m[1] - s[1]
emaLine1     = ta.ema(close, ema1Period)
emaLine2     = ta.ema(close, ema2Period)
emaLine3     = ta.ema(close, ema3Period)

// =========================================================
// DUAL SCORE LOGIC (9 điểm) Vũ Mạnh Đức 0973124824
// =========================================================
float bScore = 0
bScore += ema9 > ema21                             ? 1 : 0  // 1. Trend chính
bScore += close > vwapV                            ? 1 : 0  // 2. Giá vs VWAP
bScore += rsiVal > 52                              ? 1 : 0  // 3. RSI smooth (52 tránh noise vùng 50)
bScore += macdHist > 0 and macdHist > macdHistPrev ? 1 : 0  // 4. MACD đang tăng tốc
bScore += adx > 20                                 ? 1 : 0  // 5. Xu hướng đủ mạnh
bScore += obvVal > obvEma                          ? 1 : 0  // 6. Tiền đang vào (OBV)
bScore += stKSmooth > stD and stKSmooth < 80       ? 1 : 0  // 7. Stoch tăng, chưa overbought
bScore += close > (open + high) / 2                ? 1 : 0  // 8. Nến đóng nửa trên
bScore += volume > volAvg                          ? 1 : 0  // 9. Volume xác nhận

float rScore = 0
rScore += ema9 < ema21                             ? 1 : 0
rScore += close < vwapV                            ? 1 : 0
rScore += rsiVal < 48                              ? 1 : 0  // 48 tránh noise
rScore += macdHist < 0 and macdHist < macdHistPrev ? 1 : 0  // MACD đang giảm tốc
rScore += adx > 20                                 ? 1 : 0
rScore += obvVal < obvEma                          ? 1 : 0
rScore += stKSmooth < stD and stKSmooth > 20       ? 1 : 0  // Stoch giảm, chưa oversold
rScore += close < (open + low) / 2                 ? 1 : 0  // Nến đóng nửa dưới
rScore += volume > volAvg                          ? 1 : 0  // 9. Volume xác nhận

_scoreBase    = str.length("0973124824") - 1  // 9 tiêu chí chấm điểm
float bullPct = (bScore / _scoreBase) * 100
float bearPct = (rScore / _scoreBase) * 100
netBias       = bullPct - bearPct
biasNorm      = (netBias + 100) / 2
biasNorm     := math.max(0, math.min(100, biasNorm))
biasChange    = biasNorm - biasNorm[3]

biasColor =
     biasNorm >= 75 ? color.rgb(156, 39, 176) :  // Tím — Rất mạnh
     biasNorm >= 55 ? color.rgb( 76, 175, 80) :  // Xanh — Mạnh
     biasNorm >= 45 ? color.rgb(255, 193,  7) :  // Vàng — Trung bình
     biasNorm >= 25 ? color.rgb(255,  87, 34) :  // Cam — Yếu
                      color.rgb(244,  67, 54)     // Đỏ — Rất yếu


// =========================================================
// SUPERTREND Vũ Mạnh Đức 0973124824
// =========================================================
_phoneLen = str.length("0973124824")
_atrLen  = tradingStyle == "Ngắn hạn" ? _phoneLen - 3 : tradingStyle == "Dài hạn" ? _phoneLen : Periods
_atrMult = tradingStyle == "Ngắn hạn" ? 2.0 : tradingStyle == "Dài hạn" ? 3.0 : Multiplier
atr  = changeATR ? ta.atr(_atrLen) : ta.sma(ta.tr, _atrLen)
up   = src - _atrMult * atr
dn   = src + _atrMult * atr

var float up1 = na
var float dn1 = na
up1 := nz(up[1], up)
up  := close[1] > up1 ? math.max(up, up1) : up
dn1 := nz(dn[1], dn)
dn  := close[1] < dn1 ? math.min(dn, dn1) : dn

var int trend = 1
allowFlipToLong  = not useStrengthFilter or (biasNorm >= strongThr and biasChange > 0)
allowFlipToShort = not useStrengthFilter or (biasNorm <= weakThr   and biasChange < 0)
trend := nz(trend[1], 1)
trend := trend == -1 and close > dn1 and allowFlipToLong  ?  1 :
         trend ==  1 and close < up1 and allowFlipToShort ? -1 : trend

buySignal  = trend == 1  and trend[1] == -1
sellSignal = trend == -1 and trend[1] == 1

// ── Pivot High/Low để tính SL động ───────────────────────
_phRaw = ta.pivothigh(high, pivotLen, pivotLen)
_plRaw = ta.pivotlow(low,  pivotLen, pivotLen)
var float lastPivotHigh = na
var float lastPivotLow  = na
if not na(_phRaw)
    lastPivotHigh := _phRaw
if not na(_plRaw)
    lastPivotLow := _plRaw

upPlot = plot(trend == 1 ? up : na, "Xu hướng tăng", color.green, 2, plot.style_linebr)
dnPlot = plot(trend == 1 ? na : dn, "Xu hướng giảm", color.red,   2, plot.style_linebr)
mPlot  = plot(ohlc4, "", display=display.none)
fill(mPlot, upPlot, title="Tô màu xu hướng tăng", color=color.new(color.green, 50))
fill(mPlot, dnPlot, title="Tô màu xu hướng giảm", color=color.new(color.red,   50))
plot(ema1Show ? emaLine1 : na, "EMA 1", color=ema1Color, linewidth=1)
plot(ema2Show ? emaLine2 : na, "EMA 2", color=ema2Color, linewidth=1)
plot(ema3Show ? emaLine3 : na, "EMA 3", color=ema3Color, linewidth=1)

plotshape(buySignal  ? up : na, "Tín hiệu Mua", shape.triangleup,   location.belowbar, color.green, size=size.tiny)
plotshape(sellSignal ? dn : na, "Tín hiệu Bán", shape.triangledown, location.abovebar, color.red,   size=size.tiny)

if buySignal and showsignals
    label.new(bar_index, up, "Mua\n" + f_price(f_buyPrice(entryMode)),
         style=label.style_label_up, color=color.green, textcolor=color.white, size=size.normal)
if sellSignal and showsignals
    label.new(bar_index, dn, "Bán\n" + f_price(f_sellPrice(entryMode)),
         style=label.style_label_down, color=color.red, textcolor=color.white, size=size.normal)

// =========================================================
// BOLLINGER BAND
// =========================================================
bbBasis     = ta.sma(bbSrc, bbLength)
bbDev       = bbMult * ta.stdev(bbSrc, bbLength)
bbClr       = trend == 1 ? color.green : color.red
bbUpperPlot = plot(showBB ? bbBasis + bbDev : na, "BB Upper",  bbClr)
bbLowerPlot = plot(showBB ? bbBasis - bbDev : na, "BB Lower",  bbClr)
plot(showBB ? bbBasis : na, "BB Middle", color.yellow)
fill(bbUpperPlot, bbLowerPlot, title="BB Fill", color=color.new(bbClr, 50), display=display.none)

// =========================================================
// THEO DÕI TÍN HIỆU HIỆN TẠI Vũ Mạnh Đức 0973124824
// =========================================================
var float  signalPrice = na
var int    signalBar   = 0
var int    signalCount = 0
var string signalType  = "MUA"
var string signalDate  = ""

if buySignal or sellSignal
    signalPrice := buySignal ? f_buyPrice(entryMode)  : f_sellPrice(entryMode)
    signalBar   := bar_index
    signalCount := 0
    signalType  := buySignal ? "MUA" : "BÁN"
    signalDate  := f_today()

if not na(signalPrice)
    signalCount := bar_index - signalBar

pnl = na(signalPrice) or signalPrice == 0 ? 0.0 : signalType == "MUA" ? (close - signalPrice) / signalPrice * 100 :(signalPrice - close) / signalPrice * 100


// =========================================================
// VỊ NẾN TRÊN BIỂU ĐỒ Vũ Mạnh Đức 0973124824
// =========================================================
var array<label> candleLabels = array.new<label>()

if showCandlePattern
    _b    = math.abs(close - open)
    _r    = high - low
    _uw   = high - math.max(close, open)
    _dw   = math.min(close, open) - low
    _sl   = trend == 1 ? up : dn
    _ns   = _r > 0 and math.abs(close - _sl) / _sl * 100 <= nearThreshPct
    _minR = _r >= 0.5 * atr
    _volC = volume > volAvg

    if _ns and _minR
        _n  = ""
        _tt = ""
        if trend == 1
            if close[2] < open[2] and math.abs(close[1] - open[1]) <= math.abs(close[2] - open[2]) * 0.5 and close > open and close > (open[2] + close[2]) / 2
                _n  := "🌟\nSao Mai"
                _tt := "🌟 MORNING STAR (Sao Mai)\n3 nến: giảm mạnh → nến nhỏ → tăng mạnh vượt giữa thân nến đầu — đảo chiều tăng cực mạnh.\nÝ nghĩa: Phe mua chiếm quyền kiểm soát sau khi phe bán kiệt sức.\nXác nhận: Khối lượng nến thứ 3 cao hơn là tín hiệu mạnh."
            else if _b > 0 and _dw >= 2 * _b and _uw <= 0.5 * _b
                _n  := "🔨\nHammer"
                _tt := "🔨 HAMMER (Búa)\nĐuôi dài dưới ≥ 2× thân nến — phe mua đã phản công mạnh tại vùng hỗ trợ.\nÝ nghĩa: Tín hiệu đảo chiều tăng tiềm năng.\nXác nhận: Nến tiếp theo đóng cửa cao hơn nến Hammer."
            else if _b > 0 and _uw >= 2 * _b and _dw <= 0.5 * _b
                _n  := "🔃\nBúa Ngược"
                _tt := "🔃 INVERTED HAMMER (Búa Ngược)\nĐuôi dài trên ≥ 2× thân, xuất hiện tại đáy/hỗ trợ — phe mua cố phục hồi.\nÝ nghĩa: Tín hiệu đảo chiều tăng tiềm năng.\nXác nhận: Nến xanh tiếp theo xác nhận sức mua quay trở lại."
            else if close > open and close[1] < open[1] and open <= close[1] and close >= open[1]
                _n  := "🕯️\nBull Engulf"
                _tt := "🕯️ BULLISH ENGULFING (Nến Nhấn Chìm Tăng)\nNến tăng bao trùm toàn bộ thân nến giảm trước — lực mua vượt trội.\nÝ nghĩa: Đảo chiều tăng mạnh tại vùng hỗ trợ.\nXác nhận: Khối lượng cao hơn nến trước."
            else if close > open and close[1] < open[1] and open < close[1] and close > (open[1] + close[1]) / 2 and close < open[1]
                _n  := "🌤️\nĐường Xuyên"
                _tt := "🌤️ PIERCING LINE (Đường Xuyên)\nNến tăng mở thấp hơn thân nến giảm trước, đóng cửa vượt giữa thân nến giảm — phe mua phản công.\nÝ nghĩa: Tín hiệu đảo chiều tăng tại vùng hỗ trợ.\nXác nhận: Khối lượng cao và nến tăng tiếp theo."
            else if _r > 0 and _b / _r < 0.1 and _dw >= _uw * 1.5
                _n  := "🌅\nDoji Rồng"
                _tt := "🌅 DRAGONFLY DOJI (Doji Chuồn Chuồn)\nGiá mở = đóng cửa, đuôi dài dưới — phe bán thất bại giữ giá thấp.\nÝ nghĩa: Cảnh báo đảo chiều tăng tại hỗ trợ.\nXác nhận: Nến xanh mạnh tiếp theo là tín hiệu tốt."
            else if _r > 0 and _b / _r < 0.15
                _n  := "〰️\nDoji"
                _tt := "〰️ DOJI\nGiá mở và đóng cửa gần bằng nhau — thị trường giằng co tại hỗ trợ.\nÝ nghĩa: Do dự, chờ xác nhận chiều hướng.\nXác nhận: Nến tiếp theo quyết định xu hướng."
            else if close > open and close[1] > open[1] and close[2] > open[2] and close > close[1] and close[1] > close[2] and open < close[1] and open[1] < close[2]
                _n  := "🪖\n3 Lính"
                _tt := "🪖 THREE WHITE SOLDIERS (Ba Chiến Binh)\n3 nến xanh liên tiếp, mỗi nến mở trong thân nến trước và đóng cao dần — lực mua bền vững.\nÝ nghĩa: Xu hướng tăng mạnh, phe mua kiên định từng phiên.\nXác nhận: Nến thứ 3 có khối lượng cao nhất là tín hiệu mạnh nhất."
            else if close[1] < open[1] and close > open and math.abs(low - low[1]) / low[1] * 100 < 0.3
                _n  := "🔧\nKẹp Đáy"
                _tt := "🔧 TWEEZER BOTTOM (Kẹp Đáy)\n2 nến có đáy gần bằng nhau: đỏ → xanh — vùng hỗ trợ được kiểm tra 2 lần mà không bị phá.\nÝ nghĩa: Phe bán thất bại phá đáy, phe mua phòng thủ vững.\nXác nhận: Nến xanh tiếp theo xác nhận tín hiệu bật."
            else if high < high[1] and low > low[1]
                _n  := "📦\nInside Bar"
                _tt := "📦 INSIDE BAR (Nến Nằm Trong)\nToàn bộ biên độ nến nằm trong nến trước — thị trường tích lũy tại hỗ trợ.\nÝ nghĩa: Áp lực giảm suy yếu — chuẩn bị bứt phá tăng.\nXác nhận: Breakout lên trên đỉnh nến mẹ là tín hiệu mua."
            else if close > open and _r > 0 and _b / _r >= 0.6
                _n  := "💚\nMarubozu↑"
                _tt := "💚 MARUBOZU TĂNG\nThân nến dài, gần như không có đuôi — phe mua kiểm soát hoàn toàn.\nÝ nghĩa: Lực mua quyết đoán, xu hướng tăng có thể tiếp diễn.\nXác nhận: Khối lượng cao là dấu hiệu bứt phá."
        else
            if close[2] > open[2] and math.abs(close[1] - open[1]) <= math.abs(close[2] - open[2]) * 0.5 and close < open and close < (open[2] + close[2]) / 2
                _n  := "🌆\nSao Hôm"
                _tt := "🌆 EVENING STAR (Sao Hôm)\n3 nến: tăng mạnh → nến nhỏ → giảm mạnh dưới giữa thân nến đầu — đảo chiều giảm cực mạnh.\nÝ nghĩa: Phe bán chiếm quyền kiểm soát sau khi phe mua kiệt sức.\nXác nhận: Khối lượng nến thứ 3 cao là tín hiệu bán mạnh."
            else if _b > 0 and _uw >= 2 * _b and _dw <= 0.5 * _b
                _n  := "⭐\nSao Rơi"
                _tt := "⭐ SHOOTING STAR (Sao Băng)\nĐuôi dài trên ≥ 2× thân nến — phe mua thất bại giữ giá cao tại kháng cự.\nÝ nghĩa: Tín hiệu đảo chiều giảm tiềm năng.\nXác nhận: Nến tiếp theo đóng cửa thấp hơn xác nhận tín hiệu."
            else if _b > 0 and _dw >= 2 * _b and _uw <= 0.5 * _b
                _n  := "🪝\nNgười Treo"
                _tt := "🪝 HANGING MAN (Người Treo Cổ)\nĐuôi dài dưới ≥ 2× thân, xuất hiện tại đỉnh/kháng cự — dấu hiệu phe bán đang thăm dò.\nÝ nghĩa: Cảnh báo đảo chiều giảm tiềm năng.\nXác nhận: Nến đỏ tiếp theo xác nhận áp lực bán."
            else if close < open and close[1] > open[1] and open >= close[1] and close <= open[1]
                _n  := "🕯️\nBear Engulf"
                _tt := "🕯️ BEARISH ENGULFING (Nến Nhấn Chìm Giảm)\nNến giảm bao trùm toàn bộ thân nến tăng trước — áp lực bán áp đảo.\nÝ nghĩa: Đảo chiều giảm mạnh tại vùng kháng cự.\nXác nhận: Khối lượng cao hơn nến trước là cảnh báo rõ ràng."
            else if close < open and close[1] > open[1] and open > close[1] and close < (open[1] + close[1]) / 2 and close > open[1]
                _n  := "🌧️\nMây Đen"
                _tt := "🌧️ DARK CLOUD COVER (Mây Đen Bao Phủ)\nNến giảm mở cao hơn thân nến tăng trước, đóng cửa dưới giữa thân nến tăng — phe bán áp đảo.\nÝ nghĩa: Tín hiệu đảo chiều giảm tại vùng kháng cự.\nXác nhận: Khối lượng cao và nến đỏ tiếp theo."
            else if _r > 0 and _b / _r < 0.1 and _uw >= _dw * 1.5
                _n  := "🌃\nDoji Mộ"
                _tt := "🌃 GRAVESTONE DOJI (Doji Bia Mộ)\nGiá mở = đóng cửa, đuôi dài trên — phe mua thất bại giữ đỉnh giá.\nÝ nghĩa: Cảnh báo đảo chiều giảm mạnh tại kháng cự.\nXác nhận: Nến đỏ tiếp theo là tín hiệu bán mạnh."
            else if _r > 0 and _b / _r < 0.15
                _n  := "〰️\nDoji"
                _tt := "〰️ DOJI\nGiá mở và đóng cửa gần bằng nhau — thị trường giằng co tại kháng cự.\nÝ nghĩa: Do dự, phe mua/bán cân bằng — thường báo hiệu đảo chiều.\nXác nhận: Nến tiếp theo quyết định xu hướng."
            else if close < open and close[1] < open[1] and close[2] < open[2] and close < close[1] and close[1] < close[2] and open > close[1] and open[1] > close[2]
                _n  := "🪽\n3 Quạ Đen"
                _tt := "🪽 THREE BLACK CROWS (Ba Con Quạ)\n3 nến đỏ liên tiếp, mỗi nến mở trong thân nến trước và đóng thấp dần — áp lực bán bền vững.\nÝ nghĩa: Xu hướng giảm mạnh, phe bán kiên định từng phiên.\nXác nhận: Nến thứ 3 có khối lượng cao nhất là nguy hiểm nhất."
            else if close[1] > open[1] and close < open and math.abs(high - high[1]) / high[1] * 100 < 0.3
                _n  := "🔧\nKẹp Đỉnh"
                _tt := "🔧 TWEEZER TOP (Kẹp Đỉnh)\n2 nến có đỉnh gần bằng nhau: xanh → đỏ — vùng kháng cự được kiểm tra 2 lần mà không vượt qua.\nÝ nghĩa: Phe mua thất bại vượt đỉnh, phe bán phòng thủ vững.\nXác nhận: Nến đỏ tiếp theo xác nhận tín hiệu bán."
            else if high < high[1] and low > low[1]
                _n  := "📦\nInside Bar"
                _tt := "📦 INSIDE BAR (Nến Nằm Trong)\nToàn bộ biên độ nến nằm trong nến trước — thị trường tích lũy tại kháng cự.\nÝ nghĩa: Áp lực mua suy yếu — chuẩn bị bứt phá giảm.\nXác nhận: Breakout xuống dưới đáy nến mẹ là tín hiệu bán."
            else if close < open and _r > 0 and _b / _r >= 0.6
                _n  := "🔴\nMarubozu↓"
                _tt := "🔴 MARUBOZU GIẢM\nThân nến dài, gần như không có đuôi — phe bán kiểm soát hoàn toàn.\nÝ nghĩa: Áp lực bán lớn, xu hướng giảm có thể tiếp diễn.\nXác nhận: Khối lượng cao là tín hiệu xả hàng mạnh."

        if _n != ""
            _lbl = label.new(
                 x         = bar_index,
                 y         = trend == 1 ? low : high,
                 text      = _n,
                 style     = trend == 1 ? label.style_label_up : label.style_label_down,
                 color     = trend == 1 ? color.new(color.teal, 10) : color.new(color.maroon, 10),
                 textcolor = color.white,
                 size      = size.small,
                 tooltip   = _tt)
            array.push(candleLabels, _lbl)
            while array.size(candleLabels) > maxCandleLabels
                label.delete(array.shift(candleLabels))

// =========================================================
// TP / SL LINES Vũ Mạnh Đức 0973124824
// =========================================================
var line  lnEntry = na
var line  lnSL    = na
var line  lnTP1   = na
var line  lnTP2   = na
var line  lnTP3   = na
var label lbEntry = na
var label lbSL    = na
var label lbTP1   = na
var label lbTP2   = na
var label lbTP3   = na

// Lưu giá trị tại thời điểm tín hiệu để label không bị tính lại sai
var float saved_ep     = na
var float saved_sl     = na
var float saved_tp1    = na
var float saved_tp2    = na
var float saved_tp3    = na
var bool  saved_isLong = true

_tpslOn = showTPSL and not na(saved_ep)

// Xóa lines/labels khi có tín hiệu mới (cả long lẫn short)
if buySignal or sellSignal
    line.delete(lnEntry),  line.delete(lnSL),  line.delete(lnTP1),  line.delete(lnTP2),  line.delete(lnTP3)
    label.delete(lbEntry), label.delete(lbSL), label.delete(lbTP1), label.delete(lbTP2), label.delete(lbTP3)
    saved_ep  := na
    saved_sl  := na
    saved_tp1 := na
    saved_tp2 := na
    saved_tp3 := na

// ── LONG TPSL ────────────────────────────────────────────
if buySignal and showTPSL
    _ep     = signalPrice
    _slBase = not na(lastPivotLow) ? lastPivotLow : low
    _sl     = math.min(_slBase - slAtrMult * atr, _ep - slAtrMult * atr)
    _risk   = math.max(_ep - _sl, atr * 0.1)
    _tp1    = _ep + _risk * tp1R
    _tp2    = _ep + _risk * tp2R
    _tp3    = _ep + _risk * tp3R
    saved_ep     := _ep
    saved_sl     := _sl
    saved_tp1    := _tp1
    saved_tp2    := _tp2
    saved_tp3    := _tp3
    saved_isLong := true
    lnEntry := line.new(bar_index, _ep,  bar_index + 1, _ep,  color=color.new(#FFC107, 0), width=1, style=line.style_dotted, extend=extend.right)
    lnSL    := line.new(bar_index, _sl,  bar_index + 1, _sl,  color=color.new(#F44336, 0), width=1, style=line.style_dashed, extend=extend.right)
    lnTP1   := line.new(bar_index, _tp1, bar_index + 1, _tp1, color=color.new(#8BC34A, 0), width=1, style=line.style_dashed, extend=extend.right)
    lnTP2   := line.new(bar_index, _tp2, bar_index + 1, _tp2, color=color.new(#4CAF50, 0), width=1, style=line.style_dashed, extend=extend.right)
    lnTP3   := line.new(bar_index, _tp3, bar_index + 1, _tp3, color=color.new(#009688, 0), width=1, style=line.style_dashed, extend=extend.right)

// ── SHORT TPSL ───────────────────────────────────────────
if sellSignal and showTPSL
    _ep     = signalPrice
    _slBase = not na(lastPivotHigh) ? lastPivotHigh : high
    _sl     = math.max(_slBase + slAtrMult * atr, _ep + slAtrMult * atr)
    _risk   = math.max(_sl - _ep, atr * 0.1)
    _tp1    = _ep - _risk * tp1R
    _tp2    = _ep - _risk * tp2R
    _tp3    = _ep - _risk * tp3R
    saved_ep     := _ep
    saved_sl     := _sl
    saved_tp1    := _tp1
    saved_tp2    := _tp2
    saved_tp3    := _tp3
    saved_isLong := false
    lnEntry := line.new(bar_index, _ep,  bar_index + 1, _ep,  color=color.new(#FFC107, 0), width=1, style=line.style_dotted, extend=extend.right)
    lnSL    := line.new(bar_index, _sl,  bar_index + 1, _sl,  color=color.new(#F44336, 0), width=1, style=line.style_dashed, extend=extend.right)
    lnTP1   := line.new(bar_index, _tp1, bar_index + 1, _tp1, color=color.new(#FF7043, 0), width=1, style=line.style_dashed, extend=extend.right)
    lnTP2   := line.new(bar_index, _tp2, bar_index + 1, _tp2, color=color.new(#E53935, 0), width=1, style=line.style_dashed, extend=extend.right)
    lnTP3   := line.new(bar_index, _tp3, bar_index + 1, _tp3, color=color.new(#B71C1C, 0), width=1, style=line.style_dashed, extend=extend.right)

if barstate.islast and _tpslOn and not na(saved_ep)
    _ep   = saved_ep
    _sl   = saved_sl
    _tp1  = saved_tp1
    _tp2  = saved_tp2
    _tp3  = saved_tp3
    _isLg = saved_isLong

    // % cách entry
    _slPctStr  = str.tostring(math.round(math.abs(_sl  - _ep) / _ep * 100 * 10) / 10)
    _tp1PctStr = str.tostring(math.round(math.abs(_tp1 - _ep) / _ep * 100 * 10) / 10)
    _tp2PctStr = str.tostring(math.round(math.abs(_tp2 - _ep) / _ep * 100 * 10) / 10)
    _tp3PctStr = str.tostring(math.round(math.abs(_tp3 - _ep) / _ep * 100 * 10) / 10)

    // Long: SL xuống (-), TP lên (+) | Short: SL lên (+), TP xuống (-)
    _slSign  = _isLg ? "-" : "+"
    _tpSign  = _isLg ? "+" : "-"
    _tp1Clr  = _isLg ? color.new(#8BC34A, 0) : color.new(#FF7043, 0)
    _tp2Clr  = _isLg ? color.new(#4CAF50, 0) : color.new(#E53935, 0)
    _tp3Clr  = _isLg ? color.new(#009688, 0) : color.new(#B71C1C, 0)
    _tp1Txt  = _isLg ? color.black            : color.white
    _dirTxt  = _isLg ? "📗 LONG" : "📕 SHORT"

    label.delete(lbEntry)
    lbEntry := label.new(bar_index + 32, _ep,
         "📌 Vào (" + _dirTxt + "):  " + f_price(_ep),
         style=label.style_label_left, color=color.new(#FFC107, 0), textcolor=color.black, size=size.small)

    label.delete(lbSL)
    lbSL := label.new(bar_index + 32, _sl,
         "🛑 SL:    " + f_price(_sl) + "   " + _slSign + _slPctStr + "%",
         style=label.style_label_left, color=color.new(#F44336, 0), textcolor=color.white, size=size.small)

    label.delete(lbTP1)
    lbTP1 := label.new(bar_index + 32, _tp1,
         "🎯 T1:   " + f_price(_tp1) + "   " + _tpSign + _tp1PctStr + "%   RR 1:" + str.tostring(tp1R),
         style=label.style_label_left, color=_tp1Clr, textcolor=_tp1Txt, size=size.small)

    label.delete(lbTP2)
    lbTP2 := label.new(bar_index + 32, _tp2,
         "🎯 T2:   " + f_price(_tp2) + "   " + _tpSign + _tp2PctStr + "%   RR 1:" + str.tostring(tp2R),
         style=label.style_label_left, color=_tp2Clr, textcolor=color.white, size=size.small)

    label.delete(lbTP3)
    lbTP3 := label.new(bar_index + 32, _tp3,
         "🎯 T3:   " + f_price(_tp3) + "   " + _tpSign + _tp3PctStr + "%   RR 1:" + str.tostring(tp3R),
         style=label.style_label_left, color=_tp3Clr, textcolor=color.white, size=size.small)

// =========================================================
// HỖ TRỢ / KHÁNG CỰ Vũ Mạnh Đức 0973124824
// =========================================================
var line  lSR  = line.new(na, na, na, na)
var label lbSR = label.new(na, na, "", color=color.green, textcolor=color.white, style=label.style_label_left, size=size.small)

if showSR
    srPrice = trend == 1 ? up : dn
    srColor = trend == 1 ? color.green : color.red
    if trend != trend[1]
        line.delete(lSR)
        lSR := line.new(bar_index, srPrice, bar_index + 20, srPrice,
             color=srColor, width=1, style=line.style_dashed, extend=extend.right)
    line.set_xy1(lSR, bar_index,      srPrice)
    line.set_xy2(lSR, bar_index + 10, srPrice)
    line.set_color(lSR, srColor)
    label.set_xy(lbSR,   bar_index + 10, srPrice)
    label.set_text(lbSR, (trend == 1 ? "HT: " : "KC: ") + f_price(srPrice))
    label.set_color(lbSR, srColor)

// =========================================================
// 2 ĐƯỜNG DỌC VÙNG BACKTEST Vũ Mạnh Đức 0973124824
// =========================================================
var line  lineStart = na
var line  lineEnd   = na
var label lblStart  = na
var label lblEnd    = na

if showZoneLines and showHistory
    if time == startTime or (time > startTime and time[1] < startTime)
        line.delete(lineStart), label.delete(lblStart)
        lineStart := line.new(bar_index, low * 0.95, bar_index, high * 1.05,
             color=color.new(#00E676, 0), width=2, style=line.style_dashed, extend=extend.both)
        lblStart  := label.new(bar_index, high, "▶ BẮT ĐẦU\n" + str.format_time(startTime, "dd/MM/yyyy"),
             style=label.style_label_down, color=color.new(#00E676, 0), textcolor=color.white, size=size.small)
    if useEndTime and (time == endTime or (time > endTime and time[1] < endTime))
        line.delete(lineEnd), label.delete(lblEnd)
        lineEnd := line.new(bar_index, low * 0.95, bar_index, high * 1.05,
             color=color.new(#FF5252, 0), width=2, style=line.style_dashed, extend=extend.both)
        lblEnd  := label.new(bar_index, high, "⏹ KẾT THÚC\n" + str.format_time(endTime, "dd/MM/yyyy"),
             style=label.style_label_down, color=color.new(#FF5252, 0), textcolor=color.white, size=size.small)

// =========================================================
// BACKTEST Vũ Mạnh Đức 0973124824
// =========================================================
inBacktest = showHistory and time >= startTime and (not useEndTime or time <= endTime)

var array<string> hist_dir       = array.new<string>()
var array<string> hist_entryDate = array.new<string>()
var array<float>  hist_entryPx   = array.new<float>()
var array<string> hist_exitDate  = array.new<string>()
var array<float>  hist_exitPx    = array.new<float>()
var array<float>  hist_pnlPct    = array.new<float>()
var array<float>  hist_maxPct    = array.new<float>()
var array<int>    hist_holdBars  = array.new<int>()

var float  bt_entryPx     = na
var int    bt_entryBar    = 0
var string bt_entryDate   = ""
var string bt_dir         = ""
var int    bt_totalTrades = 0
var int    bt_winTrades   = 0
var int    bt_lossTrades  = 0
var float  bt_totalPnL    = 0.0
var float  bt_maxFav      = na

// Track max favorable excursion for current open position (runs before signal logic)
if inBacktest and not na(bt_entryPx) and bt_dir != ""
    if bt_dir == "LONG"
        _mf = (high - bt_entryPx) / bt_entryPx * 100
        bt_maxFav := na(bt_maxFav) ? _mf : math.max(bt_maxFav, _mf)
    else
        _mf = (bt_entryPx - low) / bt_entryPx * 100
        bt_maxFav := na(bt_maxFav) ? _mf : math.max(bt_maxFav, _mf)

// buySignal: đóng SHORT đang mở (nếu có) → mở LONG
if inBacktest and buySignal
    if bt_dir == "SHORT" and not na(bt_entryPx)
        _ex  = f_buyPrice(entryMode)
        _pct = (bt_entryPx - _ex) / bt_entryPx * 100
        array.push(hist_dir,       "SHORT")
        array.push(hist_entryDate, bt_entryDate)
        array.push(hist_entryPx,   bt_entryPx)
        array.push(hist_exitDate,  f_today())
        array.push(hist_exitPx,    _ex)
        array.push(hist_pnlPct,    _pct)
        array.push(hist_maxPct,    nz(bt_maxFav, 0.0))
        array.push(hist_holdBars,  bar_index - bt_entryBar)
        bt_totalTrades += 1
        bt_totalPnL    += _pct
        bt_winTrades   += _pct > 0 ? 1 : 0
        bt_lossTrades  += _pct <= 0 ? 1 : 0
    bt_entryPx   := f_buyPrice(entryMode)
    bt_entryBar  := bar_index
    bt_entryDate := f_today()
    bt_dir       := "LONG"
    bt_maxFav    := na

// sellSignal: đóng LONG đang mở (nếu có) → mở SHORT
if inBacktest and sellSignal
    if bt_dir == "LONG" and not na(bt_entryPx)
        _ex  = f_sellPrice(entryMode)
        _pct = (_ex - bt_entryPx) / bt_entryPx * 100
        array.push(hist_dir,       "LONG")
        array.push(hist_entryDate, bt_entryDate)
        array.push(hist_entryPx,   bt_entryPx)
        array.push(hist_exitDate,  f_today())
        array.push(hist_exitPx,    _ex)
        array.push(hist_pnlPct,    _pct)
        array.push(hist_maxPct,    nz(bt_maxFav, 0.0))
        array.push(hist_holdBars,  bar_index - bt_entryBar)
        bt_totalTrades += 1
        bt_totalPnL    += _pct
        bt_winTrades   += _pct > 0 ? 1 : 0
        bt_lossTrades  += _pct <= 0 ? 1 : 0
    bt_entryPx   := f_sellPrice(entryMode)
    bt_entryBar  := bar_index
    bt_entryDate := f_today()
    bt_dir       := "SHORT"
    bt_maxFav    := na

bt_winRate = bt_totalTrades > 0 ? bt_winTrades / bt_totalTrades * 100 : 0.0
bt_avgPnL  = bt_totalTrades > 0 ? bt_totalPnL  / bt_totalTrades       : 0.0

// =========================================================
// BẢNG LỊCH SỬ GIAO DỊCH Vũ Mạnh Đức 0973124824
// =========================================================
if barstate.islast and showHistory and array.size(hist_dir) > 0
    tbl_pos   = tablePosition == "bottom_right" ? position.bottom_right : tablePosition == "bottom_center" ? position.bottom_center : position.bottom_left
    tSize_h   = tableSize == "tiny" ? size.small : tableSize == "small" ? size.normal : tableSize == "normal" ? size.large : size.huge
    tSize_d   = tableSize == "tiny" ? size.tiny  : tableSize == "small" ? size.small  : tableSize == "normal" ? size.normal : size.large
    totalAll  = array.size(hist_dir)

    // Build filtered index list
    filteredIdxs = array.new<int>()
    for i = 0 to totalAll - 1
        if dirFilter == "Tất cả" or array.get(hist_dir, i) == dirFilter
            array.push(filteredIdxs, i)

    filteredTotal = array.size(filteredIdxs)
    displayCount  = math.min(filteredTotal, maxHistoryRows)
    startFilt     = math.max(0, filteredTotal - displayCount)

    float disp_totalPct  = 0.0
    int   disp_totalBars = 0
    float disp_sumEntry  = 0.0
    float disp_sumExit   = 0.0
    float disp_sumMaxPct = 0.0
    int   disp_wins      = 0
    for i = 0 to displayCount - 1
        idx            = array.get(filteredIdxs, startFilt + i)
        _p             = array.get(hist_pnlPct,   idx)
        disp_totalPct  += _p
        disp_totalBars += array.get(hist_holdBars, idx)
        disp_sumEntry  += array.get(hist_entryPx,  idx)
        disp_sumExit   += array.get(hist_exitPx,   idx)
        disp_sumMaxPct += array.get(hist_maxPct,   idx)
        disp_wins      += _p > 0 ? 1 : 0

    disp_avgEntry = disp_sumEntry / displayCount
    disp_avgExit  = disp_sumExit  / displayCount
    disp_avgBars  = disp_totalBars / displayCount

    disp_avgMaxPct = displayCount > 0 ? disp_sumMaxPct / displayCount : 0.0

    htbl = table.new(tbl_pos, 7, 4 + displayCount + 2,
         bgcolor=T_BG_DRK, border_width=1, border_color=T_BRD, frame_width=2, frame_color=T_BRD)
    r = 0

    // ── HEADER ───────────────────────────────────────────────
    endLabel  = useEndTime ? " → " + str.format_time(endTime, "dd/MM/yyyy") : " → Hiện tại"
    table.cell(htbl, 0, r, "📌 " + syminfo.ticker + "  [" + str.format_time(startTime, "dd/MM/yyyy") + endLabel + "]",
         text_color=T_WHT, text_size=tSize_h, text_halign=text.align_center, bgcolor=T_HDR)
    for i = 1 to 6
        table.cell(htbl, i, r, "", bgcolor=T_HDR)
    table.merge_cells(htbl, 0, r, 6, r)
    r += 1

    // ── INFO ROW ─────────────────────────────────────────────
    filterLabel = dirFilter == "Tất cả" ? "" : " — Lọc: " + dirFilter
    table.cell(htbl, 0, r, "Hiển thị " + str.tostring(displayCount) + "/" + str.tostring(filteredTotal) + " lệnh" + filterLabel,
         text_color=T_YLW, text_size=tSize_d, text_halign=text.align_center, bgcolor=T_BG_LGT)
    for i = 1 to 6
        table.cell(htbl, i, r, "", bgcolor=T_BG_LGT)
    table.merge_cells(htbl, 0, r, 6, r)
    r += 1

    // ── HEADER CỘT ───────────────────────────────────────────
    table.cell(htbl, 0, r, "#",             text_color=T_WHT, text_size=tSize_d, text_halign=text.align_center, bgcolor=T_HDR)
    table.cell(htbl, 1, r, "HƯỚNG",         text_color=T_WHT, text_size=tSize_d, text_halign=text.align_center, bgcolor=T_HDR)
    table.cell(htbl, 2, r, "NGÀY\nVào/Thoát", text_color=T_WHT, text_size=tSize_d, text_halign=text.align_center, bgcolor=T_HDR)
    table.cell(htbl, 3, r, "GIÁ\nVào/Thoát",  text_color=T_WHT, text_size=tSize_d, text_halign=text.align_center, bgcolor=T_HDR)
    table.cell(htbl, 4, r, "NẾN",         text_color=T_WHT, text_size=tSize_d, text_halign=text.align_center, bgcolor=T_HDR)
    table.cell(htbl, 5, r, "%",              text_color=T_WHT, text_size=tSize_d, text_halign=text.align_center, bgcolor=T_HDR)
    table.cell(htbl, 6, r, "MAX %",          text_color=T_WHT, text_size=tSize_d, text_halign=text.align_center, bgcolor=T_HDR)
    r += 1

    // ── DỮ LIỆU TỪNG LỆNH ────────────────────────────────────
    for i = 0 to displayCount - 1
        idx    = array.get(filteredIdxs, startFilt + i)
        _pct   = array.get(hist_pnlPct, idx)
        _dir   = array.get(hist_dir,    idx)
        rowBg  = i % 2 == 0 ? T_BG_DRK : T_BG_LGT
        pnlClr = _pct >= 0 ? T_GRN : T_RED
        dirClr = _dir == "LONG" ? T_GRN : T_RED
        wlTxt  = _pct > 0 ? " ✅" : " ❌"
        _dateTxt  = array.get(hist_entryDate, idx) + "\n" + array.get(hist_exitDate, idx)
        _priceTxt = f_price(array.get(hist_entryPx, idx)) + "\n" + f_price(array.get(hist_exitPx, idx))
        table.cell(htbl, 0, r, str.tostring(idx + 1), text_color=T_LBL,  text_size=tSize_d, text_halign=text.align_center, bgcolor=rowBg)
        table.cell(htbl, 1, r, _dir + wlTxt,          text_color=dirClr, text_size=tSize_d, text_halign=text.align_center, bgcolor=rowBg)
        table.cell(htbl, 2, r, _dateTxt,              text_color=T_VAL,  text_size=tSize_d, text_halign=text.align_center, bgcolor=rowBg)
        table.cell(htbl, 3, r, _priceTxt,             text_color=T_VAL,  text_size=tSize_d, text_halign=text.align_right,  bgcolor=rowBg)
        table.cell(htbl, 4, r, str.tostring(array.get(hist_holdBars, idx)), text_color=T_LBL, text_size=tSize_d, text_halign=text.align_center, bgcolor=rowBg)
        table.cell(htbl, 5, r, f_pct(_pct),           text_color=pnlClr, text_size=tSize_d, text_halign=text.align_center, bgcolor=rowBg)
        table.cell(htbl, 6, r, "+" + str.tostring(f_round2(array.get(hist_maxPct, idx))) + "%", text_color=T_YLW, text_size=tSize_d, text_halign=text.align_center, bgcolor=rowBg)
        r += 1

    // ── HÀNG TỔNG CỘNG ───────────────────────────────────────
    totClr   = disp_totalPct >= 0 ? T_GRN : T_RED
    disp_avgPct  = displayCount > 0 ? disp_totalPct / displayCount : 0.0
    avgPxTxt     = f_price(disp_avgEntry) + "\n" + f_price(disp_avgExit)
    table.cell(htbl, 0, r, "TB",                                  text_color=T_YLW,  text_size=tSize_d, text_halign=text.align_center, bgcolor=T_BG_TOT)
    table.cell(htbl, 1, r, str.tostring(displayCount) + " lệnh", text_color=T_YLW,  text_size=tSize_d, text_halign=text.align_center, bgcolor=T_BG_TOT)
    table.cell(htbl, 2, r, "-",                                   text_color=T_YLW,  text_size=tSize_d, text_halign=text.align_center, bgcolor=T_BG_TOT)
    table.cell(htbl, 3, r, avgPxTxt,                             text_color=T_YLW,  text_size=tSize_d, text_halign=text.align_right,  bgcolor=T_BG_TOT)
    table.cell(htbl, 4, r, str.tostring(math.round(disp_avgBars)), text_color=T_YLW, text_size=tSize_d, text_halign=text.align_center, bgcolor=T_BG_TOT)
    table.cell(htbl, 5, r, f_pct(disp_avgPct),                   text_color=totClr, text_size=tSize_d, text_halign=text.align_center, bgcolor=T_BG_TOT)
    table.cell(htbl, 6, r, "+" + str.tostring(f_round2(disp_avgMaxPct)) + "%", text_color=T_YLW, text_size=tSize_d, text_halign=text.align_center, bgcolor=T_BG_TOT)
    r += 1

    // ── SUMMARY ──────────────────────────────────────────────
    wrClr = bt_winRate >= 50 ? T_GRN : bt_winRate >= 40 ? T_YLW : T_RED
    table.cell(htbl, 0, r, "✅ " + str.tostring(bt_winTrades) + " thắng  ❌ " + str.tostring(bt_lossTrades) + " thua  |  Win Rate: " + str.tostring(f_round2(bt_winRate)) + "%  |  Avg PnL: " + f_pct(bt_avgPnL),
         text_color=wrClr, text_size=tSize_d, text_halign=text.align_center, bgcolor=T_BG_LGT)
    for i = 1 to 6
        table.cell(htbl, i, r, "", bgcolor=T_BG_LGT)
    table.merge_cells(htbl, 0, r, 6, r)


// =========================================================
// =========================================================
var label lbStar = na

if barstate.islast
    label.delete(lbStar)
    lbStar := label.new(
         x         = bar_index,
         y         = trend == 1 ? up : dn,
         text      = "✪",
         style     = label.style_label_center,
         color     = color.new(color.black, 100),
         textcolor = trend == 1 ? color.new(color.green, 0) : color.new(color.red, 0),
         size      = size.large)

// ===============================
// DISCLAIMER TABLE
// ===============================
var table tbDisclaimer = table.new(position.bottom_right, 1, 1)

if barstate.islast
    table.cell(
     tbDisclaimer, 
     0, 
     0, 
     "⚠️ Tín hiệu tham khảo - Quyết định đầu tư thuộc về bạn.", 
     text_color=color.gray,
     text_size=size.small)
// =========================================================
// CẢNH BÁO Vũ Mạnh Đức 0973124824
// =========================================================
alertcondition(buySignal,         "Cảnh báo điểm Mua",       "Cảnh báo điểm Mua!")
alertcondition(sellSignal,        "Cảnh báo điểm Bán",       "Cảnh báo điểm Bán!")
alertcondition(trend != trend[1], "Cảnh báo điểm Đảo chiều", "Cảnh báo điểm Đảo chiều!")