//@version=5
indicator("Hỗ trợ và Kháng cự (Vùng Khối lượng Cao)", shorttitle = "Phá vỡ & Kiểm tra lại HT/KC", overlay=true, max_boxes_count = 50)


// ---------------------------------------------------------------------------------------------------------------------}
// CÀI ĐẶT NGƯỜI DÙNG
// ---------------------------------------------------------------------------------------------------------------------{
int   lookbackPeriod = input.int(20, "Chu kỳ nhìn lại", minval=1, group = "Cài đặt")
int   vol_len        = input.int(2,  "Độ dài lọc Delta Volume",
                           tooltip = "Giá trị càng cao sẽ lọc bỏ các vùng có khối lượng thấp",
                           group   = "Cài đặt")
float box_withd      = input.float(1, "Độ rộng vùng", maxval = 1000, minval = 0, step = 0.1)


// ---------------------------------------------------------------------------------------------------------------------}
// TÍNH TOÁN CHỈ BÁO
// ---------------------------------------------------------------------------------------------------------------------{

// Hàm tính Delta Volume (khối lượng mua/bán)
upAndDownVolume() =>
    posVol = 0.0
    negVol = 0.0

    var isBuyVolume = true

    switch
        close > open => isBuyVolume := true   // Nến tăng → khối lượng mua
        close < open => isBuyVolume := false  // Nến giảm → khối lượng bán

    if isBuyVolume
        posVol += volume
    else
        negVol -= volume

    posVol + negVol


// Hàm xác định vùng hỗ trợ và kháng cự
calcSupportResistance(src, lookbackPeriod) =>
    // Khối lượng delta
    Vol    = upAndDownVolume()
    vol_hi = ta.highest(Vol / 2.5, vol_len)  // Ngưỡng khối lượng cao (lọc hỗ trợ)
    vol_lo = ta.lowest (Vol / 2.5, vol_len)  // Ngưỡng khối lượng thấp (lọc kháng cự)

    var float supportLevel      = na
    var float supportLevel_1    = na
    var float resistanceLevel   = na
    var float resistanceLevel_1 = na
    var box   sup               = na
    var box   res               = na
    var color res_color         = na
    var color sup_color         = na
    var float multi             = na

    var bool  brekout_res       = na
    var bool  brekout_sup       = na
    var bool  res_holds         = na
    var bool  sup_holds         = na

    // Xác định điểm pivot
    pivotHigh = ta.pivothigh(src, lookbackPeriod, lookbackPeriod)
    pivotLow  = ta.pivotlow (src, lookbackPeriod, lookbackPeriod)
    // Độ rộng vùng theo ATR
    atr       = ta.atr(200)
    withd     = atr * box_withd

    // Vùng HỖ TRỢ: Pivot thấp + khối lượng mua cao bất thường
    if (not na(pivotLow)) and Vol > vol_hi

        supportLevel   := pivotLow
        supportLevel_1 := supportLevel - withd

        topLeft     = chart.point.from_index(bar_index - lookbackPeriod, supportLevel)
        bottomRight = chart.point.from_index(bar_index, supportLevel_1)

        sup_color  := color.from_gradient(Vol, 0, ta.highest(Vol, 25), color(na), color.new(color.green, 30))

        sup := box.new(
                       top_left     = topLeft,
                       bottom_right = bottomRight,
                       border_color = color.green,
                       border_width = 1,
                       bgcolor      = sup_color,
                       text         = "KL: " + str.tostring(math.round(Vol, 2)),
                       text_color   = chart.fg_color,
                       text_size    = size.small
                       )


    // Vùng KHÁNG CỰ: Pivot cao + khối lượng bán cao bất thường
    if (not na(pivotHigh)) and Vol < vol_lo

        resistanceLevel   := pivotHigh
        resistanceLevel_1 := resistanceLevel + withd

        topLeft     = chart.point.from_index(bar_index - lookbackPeriod, resistanceLevel)
        bottomRight = chart.point.from_index(bar_index, resistanceLevel_1)

        res_color  := color.from_gradient(Vol, ta.lowest(Vol, 25), 0, color.new(color.red, 30), color(na))

        res := box.new(
                       top_left     = topLeft,
                       bottom_right = bottomRight,
                       border_color = color.red,
                       border_width = 1,
                       bgcolor      = res_color,
                       text         = "KL: " + str.tostring(math.round(Vol, 2)),
                       text_color   = chart.fg_color,
                       text_size    = size.small
                       )

    // Kéo dài vùng đến nến hiện tại
    sup.set_right(bar_index + 1)
    res.set_right(bar_index + 1)

    // Điều kiện phá vỡ hoặc giữ vững hỗ trợ/kháng cự
    brekout_res := ta.crossover (low,  resistanceLevel_1)  // Phá kháng cự lên trên
    res_holds   := ta.crossunder(high, resistanceLevel)    // Kháng cự giữ vững

    sup_holds   := ta.crossover (low,  supportLevel)       // Hỗ trợ giữ vững
    brekout_sup := ta.crossunder(high, supportLevel_1)     // Phá hỗ trợ xuống dưới

    // Đổi màu vùng khi bị phá hoặc được giữ
    if brekout_sup  // Hỗ trợ bị phá → chuyển đỏ
        sup.set_bgcolor(color.new(color.red, 80))
        sup.set_border_color(color.red)
        sup.set_border_style(line.style_dashed)

    if sup_holds    // Hỗ trợ giữ vững → giữ xanh
        sup.set_bgcolor(sup_color)
        sup.set_border_color(color.green)
        sup.set_border_style(line.style_solid)

    if brekout_res  // Kháng cự bị phá → chuyển xanh
        res.set_bgcolor(color.new(color.green, 80))
        res.set_border_color(color.new(color.green, 0))
        res.set_border_style(line.style_dashed)

    if res_holds    // Kháng cự giữ vững → giữ đỏ
        res.set_bgcolor(res_color)
        res.set_border_color(color.new(color.red, 0))
        res.set_border_style(line.style_solid)

    [supportLevel, resistanceLevel, brekout_res, res_holds, sup_holds, brekout_sup]


// Tính toán hỗ trợ/kháng cự và trạng thái phá vỡ
[supportLevel,
         resistanceLevel,
             brekout_res,
                 res_holds,
                     sup_holds,
                         brekout_sup] = calcSupportResistance(close, lookbackPeriod)


// Theo dõi đổi vai: Kháng cự thành Hỗ trợ và ngược lại
var bool res_is_sup = na
var bool sup_is_res = na

switch
    brekout_res => res_is_sup := true   // Vừa phá kháng cự → kháng cự đổi thành hỗ trợ
    res_holds   => res_is_sup := false  // Kháng cự giữ vững → không đổi vai

switch
    brekout_sup => sup_is_res := true   // Vừa phá hỗ trợ → hỗ trợ đổi thành kháng cự
    sup_holds   => sup_is_res := false  // Hỗ trợ giữ vững → không đổi vai


// ---------------------------------------------------------------------------------------------------------------------}
// HIỂN THỊ
// ---------------------------------------------------------------------------------------------------------------------{

// Ký hiệu ◆ đánh dấu giữ vững hoặc đổi vai
plotchar(res_holds,                  "Kháng cự giữ vững",        "◆",
             color = #e92929, size = size.tiny, location = location.abovebar, offset = -1)
plotchar(sup_holds,                  "Hỗ trợ giữ vững",          "◆",
             color = #20ca26, size = size.tiny, location = location.belowbar, offset = -1)

plotchar(brekout_res and res_is_sup[1], "Kháng cự đổi thành Hỗ trợ", "◆",
             color = #20ca26, size = size.tiny, location = location.belowbar, offset = -1)
plotchar(brekout_sup and sup_is_res[1], "Hỗ trợ đổi thành Kháng cự", "◆",
             color = #e92929, size = size.tiny, location = location.abovebar, offset = -1)

// Nhãn phá vỡ
if brekout_sup and not sup_is_res[1]
    label.new(
              bar_index[1], supportLevel[1],
              text      = "Phá Hỗ trợ",
              style     = label.style_label_down,
              color     = #7e1e1e,
              textcolor = chart.fg_color,
              size      = size.small
              )

if brekout_res and not res_is_sup[1]
    label.new(
              bar_index[1], resistanceLevel[1],
              text      = "Phá Kháng cự",
              style     = label.style_label_up,
              color     = #2b6d2d,
              textcolor = chart.fg_color,
              size      = size.small
              )


// ◆
// ---------------------------------------------------------------------------------------------------------------------}
