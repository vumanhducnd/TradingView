cursorTime     = input.time(timestamp("2025-06-01"), "Thời điểm muốn xem", group="Xem lại lịch sử")

// =========================================================
// VÙNG MUA/BÁN THEO KHỐI LƯỢNG Vũ Mạnh Đức 0973124824
// =========================================================
showVolSR    = input.bool(false, "Hiển thị vùng Mua/Bán theo khối lượng?", group="Vùng Mua/Bán (KL)",
     tooltip="Vùng XANH = hỗ trợ pivot thấp có khối lượng mua đột biến\nVùng ĐỎ = kháng cự pivot cao có khối lượng bán đột biến\n◆ xanh bên dưới = HT giữ vững hoặc KC đổi thành HT\n◆ đỏ bên trên = KC giữ vững hoặc HT đổi thành KC\nNhãn 'Phá HT' / 'Phá KC' = xác nhận phá vỡ")
vsr_lookback = input.int(20,    "Chu kỳ nhìn lại pivot",       group="Vùng Mua/Bán (KL)", minval=1,
     tooltip="Số nến để xác định pivot high/low. Nhỏ hơn = nhạy hơn, nhiều vùng hơn")
vsr_vol_len  = input.int(2,     "Độ nhạy lọc khối lượng",      group="Vùng Mua/Bán (KL)", minval=1,
     tooltip="So sánh KL với N nến gần nhất. Càng cao = lọc càng gắt, chỉ giữ vùng KL thực sự đột biến")
vsr_box_wd   = input.float(1.0, "Độ dày vùng (×ATR200)",       group="Vùng Mua/Bán (KL)", minval=0.0, step=0.1,
     tooltip="Độ dày của vùng hỗ trợ/kháng cự tính bằng bội số của ATR(200)")

// =========================================================
// HÀM TIỆN ÍCH Vũ Mạnh Đức 0973124824
// =========================================================
f_pad(v)        => v < 10 ? "0" + str.tostring(v) : str.tostring(v)
f_price(p)      => p < 10000 ? str.tostring(math.round(p * 100) / 100, "#.##") : str.tostring(math.round(p / 10) / 100, "#,###.##")
f_million(v)    => str.tostring(math.round(v * 100) / 100, "#,###.##")
f_sign(v)       => v >= 0 ? "+" : ""
f_buyPrice(md)  => md == "Lý tưởng nhất" ? low  : md == "Lý tưởng" ? hl2  : high
f_sellPrice(md) => md == "Lý tưởng nhất" ? high : md == "Lý tưởng" ? hl2  : low
f_modeLabel(md) => md == "Lý tưởng nhất" ? "🏆 Lý tưởng nhất" : md == "Lý tưởng" ? "⭐ Lý tưởng" : "📊 Thực tế"
f_round2(v)     => math.round(v * 100) / 100
f_pct(v)        => f_sign(v) + str.tostring(f_round2(v)) + "%"
f_today()       => f_pad(dayofmonth) + "/" + f_pad(month) + "/" + str.tostring(year)
f_tsize(s)      => s == "tiny" ? size.tiny : s == "small" ? size.small : s == "normal" ? size.normal : s == "large" ? size.large : size.huge

// =========================================================
// HÀM VÙNG MUA/BÁN THEO KHỐI LƯỢNG Vũ Mạnh Đức 0973124824
// =========================================================
_vsr_delta() =>
    posVol = 0.0
    negVol = 0.0
    var bool isBuy = true
    switch
        close > open => isBuy := true
        close < open => isBuy := false
    if isBuy
        posVol += volume
    else
        negVol -= volume
    posVol + negVol

_vsr_calc(src, lb) =>
    Vol    = _vsr_delta()
    vol_hi = ta.highest(Vol / 2.5, vsr_vol_len)
    vol_lo = ta.lowest (Vol / 2.5, vsr_vol_len)

    var float supLvl  = na
    var float supLvl1 = na
    var float resLvl  = na
    var float resLvl1 = na
    var box   supBox  = box.new(na, na, na, na)
    var box   resBox  = box.new(na, na, na, na)

    var bool vsr_brkRes = false
    var bool vsr_brkSup = false
    var bool vsr_hldRes = false
    var bool vsr_hldSup = false

    pivHigh = ta.pivothigh(src, lb, lb)
    pivLow  = ta.pivotlow (src, lb, lb)
    atr200  = ta.atr(200)
    wd      = atr200 * vsr_box_wd

    // Vùng HỖ TRỢ: pivot thấp + KL mua đột biến
    if not na(pivLow) and Vol > vol_hi
        supLvl  := pivLow
        supLvl1 := supLvl - wd
        if showVolSR
            supBox := box.new(
                 chart.point.from_index(bar_index - lb, supLvl),
                 chart.point.from_index(bar_index, supLvl1),
                 border_color = color.new(color.green, 0),
                 border_width = 1,
                 bgcolor      = color.new(color.green, 70),
                 text         = "KL: " + str.tostring(Vol, format.volume),
                 text_color   = chart.fg_color,
                 text_size    = size.small)

    // Vùng KHÁNG CỰ: pivot cao + KL bán đột biến
    if not na(pivHigh) and Vol < vol_lo
        resLvl  := pivHigh
        resLvl1 := resLvl + wd
        if showVolSR
            resBox := box.new(
                 chart.point.from_index(bar_index - lb, resLvl),
                 chart.point.from_index(bar_index, resLvl1),
                 border_color = color.new(color.red, 0),
                 border_width = 1,
                 bgcolor      = color.new(color.red, 70),
                 text         = "KL: " + str.tostring(Vol, format.volume),
                 text_color   = chart.fg_color,
                 text_size    = size.small)

    // Kéo dài vùng đến nến hiện tại
    if showVolSR
        supBox.set_right(bar_index + 1)
        resBox.set_right(bar_index + 1)

    // Phát hiện phá vỡ / giữ vững
    vsr_brkRes := ta.crossover (low,  resLvl1)
    vsr_hldRes := ta.crossunder(high, resLvl)
    vsr_hldSup := ta.crossover (low,  supLvl)
    vsr_brkSup := ta.crossunder(high, supLvl1)

    // Đổi màu vùng theo trạng thái
    if showVolSR
        if vsr_brkSup
            supBox.set_bgcolor(color.new(color.red, 80))
            supBox.set_border_color(color.red)
            supBox.set_border_style(line.style_dashed)
        if vsr_hldSup
            supBox.set_bgcolor(color.new(color.green, 70))
            supBox.set_border_color(color.new(color.green, 0))
            supBox.set_border_style(line.style_solid)
        if vsr_brkRes
            resBox.set_bgcolor(color.new(color.green, 80))
            resBox.set_border_color(color.new(color.green, 0))
            resBox.set_border_style(line.style_dashed)
        if vsr_hldRes
            resBox.set_bgcolor(color.new(color.red, 70))
            resBox.set_border_color(color.new(color.red, 0))
            resBox.set_border_style(line.style_solid)

    [supLvl, resLvl, vsr_brkRes, vsr_hldRes, vsr_hldSup, vsr_brkSup]

// =========================================================
// PALETTE Vũ Mạnh Đức 0973124824
// =========================================================
isDark   = themeMode == "Dark"
T_BG_DRK = isDark ? color.new(#1a1a1a, 5)  : color.new(#FFFFFF, 5)
T_BG_LGT = isDark ? color.new(#2a2a2a, 5)  : color.new(#F5F5F5, 5)
T_BG_TOT = isDark ? color.new(#1e3a5f, 0)  : color.new(#D6E9FF, 0)
T_HDR    = color.new(#2196F3, 0)
T_WHT    = color.new(#FFFFFF, 0)
T_LBL    = isDark ? color.new(#E0E0E0, 0)  : color.new(#444444, 0)
T_VAL    = isDark ? color.new(#FFFFFF, 0)  : color.new(#111111, 0)
T_YLW    = isDark ? color.new(#FFC107, 0)  : color.new(#B8860B, 0)
T_GRN    = color.new(#4CAF50, 0)
T_RED    = color.new(#F44336, 0)
T_BRD    = color.new(#2196F3, 0)

// =========================================================
// CHỈ BÁO KỸ THUẬT Vũ Mạnh Đức 0973124824
// =========================================================
ema9         = ta.ema(close, 9)
ema21        = ta.ema(close, 21)
vwapV        = ta.vwap(hlc3)
rsiVal       = ta.ema(ta.rsi(close, 14), 3)
[m, s, _]    = ta.macd(close, 12, 26, 9)
[_, _, adx]  = ta.dmi(14, 14)
volAvg       = ta.sma(volume, 20)
obvVal       = ta.obv
obvEma       = ta.ema(obvVal, 10)
stK          = ta.stoch(close, high, low, 14)
stD          = ta.sma(stK, 3)
stKSmooth    = ta.ema(stK, 3)
macdHist     = m - s
macdHistPrev = m[1] - s[1]
emaLine1     = ta.ema(close, ema1Period)
emaLine2     = ta.ema(close, ema2Period)
emaLine3     = ta.ema(close, ema3Period)

// =========================================================
// SIÊU CỔ PHIẾU (SUPER STOCK) Vũ Mạnh Đức 0973124824
// =========================================================
_ss_ema50    = ta.ema(close, 50)
_ss_ema200   = ta.ema(close, 200)
_high52w     = ta.highest(close, 252)
_ss1         = close > _ss_ema200                        // Giá > EMA200
_ss2         = _ss_ema200 > _ss_ema200[20]               // EMA200 đang tăng
_ss3         = not na(_high52w) and close >= _high52w * 0.90  // Gần/phá đỉnh 52 tuần
_ss4         = _ss_ema50 > _ss_ema200                    // EMA50 > EMA200
_ss5         = close > _ss_ema50                         // Giá > EMA50
_ss6         = adx > 25                                  // Xu hướng đủ mạnh
_ss7         = volAvg > ta.sma(volume, 60)               // Volume đang tăng
_ss_avgValue = ta.sma(close * volume, 20)
_ss_liquid   = _ss_avgValue >= ssLiqThresh * 1000000000
superScore   = (_ss1 ? 1 : 0) + (_ss2 ? 1 : 0) + (_ss3 ? 1 : 0) + (_ss4 ? 1 : 0) + (_ss5 ? 1 : 0) + (_ss6 ? 1 : 0) + (_ss7 ? 1 : 0)
isSuperStock = _ss_liquid and superScore >= 5
bgcolor(showSuperStock and isSuperStock ? color.new(#FFD700, 88) : na, title="Nền Siêu cổ phiếu")
plotshape(showSuperStock and isSuperStock, "💎 Siêu cổ phiếu", shape.diamond, location.top, color.new(#FFD700, 0), size=size.tiny)

// =========================================================
// DUAL SCORE LOGIC (9 điểm) Vũ Mạnh Đức 0973124824
// =========================================================
float bScore = 0
bScore += ema9 > ema21                             ? 1 : 0  // 1. Trend chính
bScore += close > vwapV                            ? 1 : 0  // 2. Giá vs VWAP
bScore += rsiVal > 52                              ? 1 : 0  // 3. RSI smooth (52 tránh noise vùng 50)
bScore += macdHist > 0 and macdHist > macdHistPrev ? 1 : 0  // 4. MACD đang tăng tốc
bScore += adx > 20                                 ? 1 : 0  // 5. Xu hướng đủ mạnh
bScore += obvVal > obvEma                          ? 1 : 0  // 6. Tiền đang vào (OBV)
bScore += stKSmooth > stD and stKSmooth < 80       ? 1 : 0  // 7. Stoch tăng, chưa overbought
bScore += close > (open + high) / 2                ? 1 : 0  // 8. Nến đóng nửa trên
bScore += volume > volAvg                          ? 1 : 0  // 9. Volume xác nhận

float rScore = 0
rScore += ema9 < ema21                             ? 1 : 0
rScore += close < vwapV                            ? 1 : 0
rScore += rsiVal < 48                              ? 1 : 0  // 48 tránh noise
rScore += macdHist < 0 and macdHist < macdHistPrev ? 1 : 0  // MACD đang giảm tốc
rScore += adx > 20                                 ? 1 : 0
rScore += obvVal < obvEma                          ? 1 : 0
rScore += stKSmooth < stD and stKSmooth > 20       ? 1 : 0  // Stoch giảm, chưa oversold
rScore += close < (open + low) / 2                 ? 1 : 0  // Nến đóng nửa dưới
rScore += volume > volAvg                          ? 1 : 0  // 9. Volume xác nhận

_scoreBase    = str.length("0973124824") - 1  // 9 tiêu chí chấm điểm
float bullPct = (bScore / _scoreBase) * 100
float bearPct = (rScore / _scoreBase) * 100
netBias       = bullPct - bearPct
biasNorm      = (netBias + 100) / 2
biasNorm     := math.max(0, math.min(100, biasNorm))
biasChange    = biasNorm - biasNorm[3]

biasColor =
     biasNorm >= 75 ? color.rgb(156, 39, 176) :  // Tím — Rất mạnh
     biasNorm >= 55 ? color.rgb( 76, 175, 80) :  // Xanh — Mạnh
     biasNorm >= 45 ? color.rgb(255, 193,  7) :  // Vàng — Trung bình
     biasNorm >= 25 ? color.rgb(255,  87, 34) :  // Cam — Yếu
                      color.rgb(244,  67, 54)     // Đỏ — Rất yếu

biasTextVN =
     biasNorm >= 75 ? "RẤT MẠNH"   :
     biasNorm >= 55 ? "MẠNH"       :
     biasNorm >= 45 ? "TRUNG BÌNH" :
     biasNorm >= 25 ? "YẾU"        :
                      "RẤT YẾU"

biasArrow = biasChange > 2 ? " ↑" : biasChange < -2 ? " ↓" : " →"

// =========================================================
// SUPERTREND Vũ Mạnh Đức 0973124824
// =========================================================
_phoneLen = str.length("0973124824")
_atrLen  = tradingStyle == "Ngắn hạn" ? _phoneLen - 3 : tradingStyle == "Dài hạn" ? _phoneLen : Periods
_atrMult = tradingStyle == "Ngắn hạn" ? 2.0 : tradingStyle == "Dài hạn" ? 3.0 : Multiplier
atr  = changeATR ? ta.atr(_atrLen) : ta.sma(ta.tr, _atrLen)
up   = src - _atrMult * atr
dn   = src + _atrMult * atr

var float up1 = na
var float dn1 = na
up1 := nz(up[1], up)
up  := close[1] > up1 ? math.max(up, up1) : up
dn1 := nz(dn[1], dn)
dn  := close[1] < dn1 ? math.min(dn, dn1) : dn

var int trend = 1
trend := nz(trend[1], 1)
trend := trend == -1 and close > dn1 ?  1 :
         trend ==  1 and close < up1 ? -1 : trend

buySignal  = trend == 1  and trend[1] == -1
sellSignal = trend == -1 and trend[1] ==  1

// ── Pivot High/Low để tính SL động ───────────────────────
_phRaw = ta.pivothigh(high, pivotLen, pivotLen)
_plRaw = ta.pivotlow(low,  pivotLen, pivotLen)
var float lastPivotHigh = na
var float lastPivotLow  = na
if not na(_phRaw)
    lastPivotHigh := _phRaw
if not na(_plRaw)
    lastPivotLow := _plRaw

upPlot = plot(trend == 1 ? up : na, "Xu hướng tăng", na, 2, plot.style_linebr)
dnPlot = plot(trend == 1 ? na : dn, "Xu hướng giảm", na, 2, plot.style_linebr)
mPlot  = plot(ohlc4, "", display=display.none)
fill(mPlot, upPlot, title="Tô màu xu hướng tăng", color=na)
fill(mPlot, dnPlot, title="Tô màu xu hướng giảm", color=na)
plot(emaLine1, "EMA 1", color=color.new(#FF9800, 0), linewidth=2, display=display.none)
plot(emaLine2, "EMA 2", color=color.new(#26C6DA, 0), linewidth=3, display=display.none)
plot(emaLine3, "EMA 3", color=color.new(#9C27B0, 0), linewidth=4, display=display.none)

plotshape(buySignal  ? up : na, "Tín hiệu Mua", shape.triangleup,   location.belowbar, color.green, size=size.tiny)
plotshape(sellSignal ? dn : na, "Tín hiệu Bán", shape.triangledown, location.abovebar, color.red,   size=size.tiny)

if buySignal and showsignals
    label.new(bar_index, up, "Vào trend\n" + f_price(f_buyPrice(entryMode)),
         style=label.style_label_up, color=color.green, textcolor=color.white, size=size.normal)
if sellSignal and showsignals
    label.new(bar_index, dn, "Hết trend\n" + f_price(f_sellPrice(entryMode)),
         style=label.style_label_down, color=color.red, textcolor=color.white, size=size.normal)

// =========================================================
// BOLLINGER BAND
// =========================================================
bbBasis     = ta.sma(bbSrc, bbLength)
bbDev       = bbMult * ta.stdev(bbSrc, bbLength)
bbUpperPlot = plot(showBB ? bbBasis + bbDev : na, "BB Upper", color = na)
bbLowerPlot = plot(showBB ? bbBasis - bbDev : na, "BB Lower", color = na)
plot(showBB ? bbBasis : na, "BB Middle", color = color.new(color.yellow,0))
fill(bbUpperPlot, bbLowerPlot, title="BB Fill", color = trend == 1 ? color.new(color.green, 50) : color.new(color.red, 50))

// =========================================================
// THEO DÕI TÍN HIỆU HIỆN TẠI Vũ Mạnh Đức 0973124824
// =========================================================
var float  signalPrice = na
var int    signalBar   = 0
var int    signalCount = 0
var string signalType  = "VÀO TREND"
var string signalDate  = ""

if buySignal or sellSignal
    signalPrice := buySignal ? f_buyPrice(entryMode)  : f_sellPrice(entryMode)
    signalBar   := bar_index
    signalCount := 0
    signalType  := buySignal ? "VÀO TREND" : "HẾT TREND"
    signalDate  := f_today()

if not na(signalPrice)
    signalCount := bar_index - signalBar

pnl = na(signalPrice) or signalPrice == 0 ? 0.0 : signalType == "VÀO TREND" ? (close - signalPrice) / signalPrice * 100 :(signalPrice - close) / signalPrice * 100

// =========================================================
// THEO DÕI TÍN HIỆU TẠI CON TRỎ THỜI GIAN Vũ Mạnh Đức 0973124824
// =========================================================
var float  tc_entryPrice = na
var string tc_type       = "VÀO TREND"
var string tc_date       = ""
var int    tc_entryBar   = 0
var int    tc_cursorBar  = na
var float  tc_closeRef   = na
var int    tc_holdCount  = 0
var float  tc_srPrice    = na
var float  tc_liqDay     = na
var int    tc_trend      = 1

if showTimeCursor
    if time <= cursorTime
        if buySignal or sellSignal
            tc_entryPrice := buySignal ? f_buyPrice(entryMode) : f_sellPrice(entryMode)
            tc_type       := buySignal ? "VÀO TREND" : "HẾT TREND"
            tc_date       := f_today()
            tc_entryBar   := bar_index
        if not na(tc_entryPrice)
            tc_holdCount  := bar_index - tc_entryBar
        tc_closeRef := close
        tc_srPrice  := trend == 1 ? up : dn
        tc_liqDay   := close * volume
        tc_trend    := trend
    if time == cursorTime or (time > cursorTime and time[1] < cursorTime)
        tc_cursorBar := bar_index

// =========================================================
// VOLUME TÍCH LŨY THEO TREND Vũ Mạnh Đức 0973124824
// =========================================================
var float trend_buy_vol  = 0.0
var float trend_sell_vol = 0.0

if ta.change(trend) != 0
    trend_buy_vol  := 0.0
    trend_sell_vol := 0.0

trend_buy_vol  += close > open ? volume : 0
trend_sell_vol += close < open ? volume : 0

avg_trend_vol = (trend_buy_vol + trend_sell_vol) / 2
delta_vol_pct = avg_trend_vol == 0 ? 0.0 : (trend_buy_vol - trend_sell_vol) / avg_trend_vol * 100

// =========================================================
// VỊ NẾN TRÊN BIỂU ĐỒ Vũ Mạnh Đức 0973124824
// =========================================================
var array<label> candleLabels = array.new<label>()

if showCandlePattern
    _b    = math.abs(close - open)
    _r    = high - low
    _uw   = high - math.max(close, open)
    _dw   = math.min(close, open) - low
    _sl   = trend == 1 ? up : dn
    _ns   = _r > 0 and math.abs(close - _sl) / _sl * 100 <= nearThreshPct
    _minR = _r >= 0.5 * atr
    _volC = volume > volAvg

    if _ns and _minR
        _n  = ""
        _tt = ""
        if trend == 1
            if close[2] < open[2] and math.abs(close[1] - open[1]) <= math.abs(close[2] - open[2]) * 0.5 and close > open and close > (open[2] + close[2]) / 2
                _n  := "🌟\nSao Mai"
                _tt := "🌟 MORNING STAR (Sao Mai)\n3 nến: giảm mạnh → nến nhỏ → tăng mạnh vượt giữa thân nến đầu — đảo chiều tăng cực mạnh.\nÝ nghĩa: Phe mua chiếm quyền kiểm soát sau khi phe bán kiệt sức.\nXác nhận: Khối lượng nến thứ 3 cao hơn là tín hiệu mạnh."
            else if _b > 0 and _dw >= 2 * _b and _uw <= 0.5 * _b
                _n  := "🔨\nHammer"
                _tt := "🔨 HAMMER (Búa)\nĐuôi dài dưới ≥ 2× thân nến — phe mua đã phản công mạnh tại vùng hỗ trợ.\nÝ nghĩa: Tín hiệu đảo chiều tăng tiềm năng.\nXác nhận: Nến tiếp theo đóng cửa cao hơn nến Hammer."
            else if _b > 0 and _uw >= 2 * _b and _dw <= 0.5 * _b
                _n  := "🔃\nBúa Ngược"
                _tt := "🔃 INVERTED HAMMER (Búa Ngược)\nĐuôi dài trên ≥ 2× thân, xuất hiện tại đáy/hỗ trợ — phe mua cố phục hồi.\nÝ nghĩa: Tín hiệu đảo chiều tăng tiềm năng.\nXác nhận: Nến xanh tiếp theo xác nhận sức mua quay trở lại."
            else if close > open and close[1] < open[1] and open <= close[1] and close >= open[1]
                _n  := "🕯️\nBull Engulf"
                _tt := "🕯️ BULLISH ENGULFING (Nến Nhấn Chìm Tăng)\nNến tăng bao trùm toàn bộ thân nến giảm trước — lực mua vượt trội.\nÝ nghĩa: Đảo chiều tăng mạnh tại vùng hỗ trợ.\nXác nhận: Khối lượng cao hơn nến trước."
            else if close > open and close[1] < open[1] and open < close[1] and close > (open[1] + close[1]) / 2 and close < open[1]
                _n  := "🌤️\nĐường Xuyên"
                _tt := "🌤️ PIERCING LINE (Đường Xuyên)\nNến tăng mở thấp hơn thân nến giảm trước, đóng cửa vượt giữa thân nến giảm — phe mua phản công.\nÝ nghĩa: Tín hiệu đảo chiều tăng tại vùng hỗ trợ.\nXác nhận: Khối lượng cao và nến tăng tiếp theo."
            else if _r > 0 and _b / _r < 0.1 and _dw >= _uw * 1.5
                _n  := "🌅\nDoji Rồng"
                _tt := "🌅 DRAGONFLY DOJI (Doji Chuồn Chuồn)\nGiá mở = đóng cửa, đuôi dài dưới — phe bán thất bại giữ giá thấp.\nÝ nghĩa: Cảnh báo đảo chiều tăng tại hỗ trợ.\nXác nhận: Nến xanh mạnh tiếp theo là tín hiệu tốt."
            else if _r > 0 and _b / _r < 0.15
                _n  := "〰️\nDoji"
                _tt := "〰️ DOJI\nGiá mở và đóng cửa gần bằng nhau — thị trường giằng co tại hỗ trợ.\nÝ nghĩa: Do dự, chờ xác nhận chiều hướng.\nXác nhận: Nến tiếp theo quyết định xu hướng."
            else if close > open and close[1] > open[1] and close[2] > open[2] and close > close[1] and close[1] > close[2] and open < close[1] and open[1] < close[2]
                _n  := "🪖\n3 Lính"
                _tt := "🪖 THREE WHITE SOLDIERS (Ba Chiến Binh)\n3 nến xanh liên tiếp, mỗi nến mở trong thân nến trước và đóng cao dần — lực mua bền vững.\nÝ nghĩa: Xu hướng tăng mạnh, phe mua kiên định từng phiên.\nXác nhận: Nến thứ 3 có khối lượng cao nhất là tín hiệu mạnh nhất."
            else if close[1] < open[1] and close > open and math.abs(low - low[1]) / low[1] * 100 < 0.3
                _n  := "🔧\nKẹp Đáy"
                _tt := "🔧 TWEEZER BOTTOM (Kẹp Đáy)\n2 nến có đáy gần bằng nhau: đỏ → xanh — vùng hỗ trợ được kiểm tra 2 lần mà không bị phá.\nÝ nghĩa: Phe bán thất bại phá đáy, phe mua phòng thủ vững.\nXác nhận: Nến xanh tiếp theo xác nhận tín hiệu bật."
            else if high < high[1] and low > low[1]
                _n  := "📦\nInside Bar"
                _tt := "📦 INSIDE BAR (Nến Nằm Trong)\nToàn bộ biên độ nến nằm trong nến trước — thị trường tích lũy tại hỗ trợ.\nÝ nghĩa: Áp lực giảm suy yếu — chuẩn bị bứt phá tăng.\nXác nhận: Breakout lên trên đỉnh nến mẹ là tín hiệu mua."
            else if close > open and _r > 0 and _b / _r >= 0.6
                _n  := "💚\nMarubozu↑"
                _tt := "💚 MARUBOZU TĂNG\nThân nến dài, gần như không có đuôi — phe mua kiểm soát hoàn toàn.\nÝ nghĩa: Lực mua quyết đoán, xu hướng tăng có thể tiếp diễn.\nXác nhận: Khối lượng cao là dấu hiệu bứt phá."
        else if not isSuperStock
            if close[2] > open[2] and math.abs(close[1] - open[1]) <= math.abs(close[2] - open[2]) * 0.5 and close < open and close < (open[2] + close[2]) / 2
                _n  := "🌆\nSao Hôm"
                _tt := "🌆 EVENING STAR (Sao Hôm)\n3 nến: tăng mạnh → nến nhỏ → giảm mạnh dưới giữa thân nến đầu — đảo chiều giảm cực mạnh.\nÝ nghĩa: Phe bán chiếm quyền kiểm soát sau khi phe mua kiệt sức.\nXác nhận: Khối lượng nến thứ 3 cao là tín hiệu bán mạnh."
            else if _b > 0 and _uw >= 2 * _b and _dw <= 0.5 * _b
                _n  := "⭐\nSao Rơi"
                _tt := "⭐ SHOOTING STAR (Sao Băng)\nĐuôi dài trên ≥ 2× thân nến — phe mua thất bại giữ giá cao tại kháng cự.\nÝ nghĩa: Tín hiệu đảo chiều giảm tiềm năng.\nXác nhận: Nến tiếp theo đóng cửa thấp hơn xác nhận tín hiệu."
            else if _b > 0 and _dw >= 2 * _b and _uw <= 0.5 * _b
                _n  := "🪝\nNgười Treo"
                _tt := "🪝 HANGING MAN (Người Treo Cổ)\nĐuôi dài dưới ≥ 2× thân, xuất hiện tại đỉnh/kháng cự — dấu hiệu phe bán đang thăm dò.\nÝ nghĩa: Cảnh báo đảo chiều giảm tiềm năng.\nXác nhận: Nến đỏ tiếp theo xác nhận áp lực bán."
            else if close < open and close[1] > open[1] and open >= close[1] and close <= open[1]
                _n  := "🕯️\nBear Engulf"
                _tt := "🕯️ BEARISH ENGULFING (Nến Nhấn Chìm Giảm)\nNến giảm bao trùm toàn bộ thân nến tăng trước — áp lực bán áp đảo.\nÝ nghĩa: Đảo chiều giảm mạnh tại vùng kháng cự.\nXác nhận: Khối lượng cao hơn nến trước là cảnh báo rõ ràng."
            else if close < open and close[1] > open[1] and open > close[1] and close < (open[1] + close[1]) / 2 and close > open[1]
                _n  := "🌧️\nMây Đen"
                _tt := "🌧️ DARK CLOUD COVER (Mây Đen Bao Phủ)\nNến giảm mở cao hơn thân nến tăng trước, đóng cửa dưới giữa thân nến tăng — phe bán áp đảo.\nÝ nghĩa: Tín hiệu đảo chiều giảm tại vùng kháng cự.\nXác nhận: Khối lượng cao và nến đỏ tiếp theo."
            else if _r > 0 and _b / _r < 0.1 and _uw >= _dw * 1.5
                _n  := "🌃\nDoji Mộ"
                _tt := "🌃 GRAVESTONE DOJI (Doji Bia Mộ)\nGiá mở = đóng cửa, đuôi dài trên — phe mua thất bại giữ đỉnh giá.\nÝ nghĩa: Cảnh báo đảo chiều giảm mạnh tại kháng cự.\nXác nhận: Nến đỏ tiếp theo là tín hiệu bán mạnh."
            else if _r > 0 and _b / _r < 0.15
                _n  := "〰️\nDoji"
                _tt := "〰️ DOJI\nGiá mở và đóng cửa gần bằng nhau — thị trường giằng co tại kháng cự.\nÝ nghĩa: Do dự, phe mua/bán cân bằng — thường báo hiệu đảo chiều.\nXác nhận: Nến tiếp theo quyết định xu hướng."
            else if close < open and close[1] < open[1] and close[2] < open[2] and close < close[1] and close[1] < close[2] and open > close[1] and open[1] > close[2]
                _n  := "🪽\n3 Quạ Đen"
                _tt := "🪽 THREE BLACK CROWS (Ba Con Quạ)\n3 nến đỏ liên tiếp, mỗi nến mở trong thân nến trước và đóng thấp dần — áp lực bán bền vững.\nÝ nghĩa: Xu hướng giảm mạnh, phe bán kiên định từng phiên.\nXác nhận: Nến thứ 3 có khối lượng cao nhất là nguy hiểm nhất."
            else if close[1] > open[1] and close < open and math.abs(high - high[1]) / high[1] * 100 < 0.3
                _n  := "🔧\nKẹp Đỉnh"
                _tt := "🔧 TWEEZER TOP (Kẹp Đỉnh)\n2 nến có đỉnh gần bằng nhau: xanh → đỏ — vùng kháng cự được kiểm tra 2 lần mà không vượt qua.\nÝ nghĩa: Phe mua thất bại vượt đỉnh, phe bán phòng thủ vững.\nXác nhận: Nến đỏ tiếp theo xác nhận tín hiệu bán."
            else if high < high[1] and low > low[1]
                _n  := "📦\nInside Bar"
                _tt := "📦 INSIDE BAR (Nến Nằm Trong)\nToàn bộ biên độ nến nằm trong nến trước — thị trường tích lũy tại kháng cự.\nÝ nghĩa: Áp lực mua suy yếu — chuẩn bị bứt phá giảm.\nXác nhận: Breakout xuống dưới đáy nến mẹ là tín hiệu bán."
            else if close < open and _r > 0 and _b / _r >= 0.6
                _n  := "🔴\nMarubozu↓"
                _tt := "🔴 MARUBOZU GIẢM\nThân nến dài, gần như không có đuôi — phe bán kiểm soát hoàn toàn.\nÝ nghĩa: Áp lực bán lớn, xu hướng giảm có thể tiếp diễn.\nXác nhận: Khối lượng cao là tín hiệu xả hàng mạnh."

        if _n != ""
            _lbl = label.new(
                 x         = bar_index,
                 y         = trend == 1 ? low : high,
                 text      = _n,
                 style     = trend == 1 ? label.style_label_up : label.style_label_down,
                 color     = trend == 1 ? color.new(color.teal, 10) : color.new(color.maroon, 10),
                 textcolor = color.white,
                 size      = size.small,
                 tooltip   = _tt)
            array.push(candleLabels, _lbl)
            while array.size(candleLabels) > maxCandleLabels
                label.delete(array.shift(candleLabels))

// =========================================================
// TP / SL LINES Vũ Mạnh Đức 0973124824
// =========================================================
var line  lnEntry = na
var line  lnTP1   = na
var line  lnTP2   = na
var line  lnTP3   = na
var label lbEntry = na
var label lbTP1   = na
var label lbTP2   = na
var label lbTP3   = na

// Lưu giá trị tại thời điểm buySignal để label không bị tính lại sai
var float saved_ep   = na
var float saved_tp1  = na
var float saved_tp2  = na
var float saved_tp3  = na
var line  lnSLVN     = na
var label lbSLVN     = na
var bool  tp1_hit    = false
var bool  tp2_hit    = false
var bool  tp3_hit    = false
var label lbTP1hit   = na
var label lbTP2hit   = na
var label lbTP3hit   = na

_tpslOn = showTPSL and signalType == "VÀO TREND" and not na(signalPrice) and trend == 1

if sellSignal
    line.delete(lnEntry),  line.delete(lnTP1),  line.delete(lnTP2),  line.delete(lnTP3)
    label.delete(lbEntry), label.delete(lbTP1), label.delete(lbTP2), label.delete(lbTP3)
    line.delete(lnSLVN),   label.delete(lbSLVN)
    saved_ep  := na
    saved_tp1 := na
    saved_tp2 := na
    saved_tp3 := na
    tp1_hit := false,  tp2_hit := false,  tp3_hit := false
    label.delete(lbTP1hit), lbTP1hit := na
    label.delete(lbTP2hit), lbTP2hit := na
    label.delete(lbTP3hit), lbTP3hit := na

if buySignal and showTPSL
    _ep     = signalPrice
    _slBase = not na(lastPivotLow) ? lastPivotLow : low
    _sl     = math.min(_slBase - slAtrMult * atr, _ep - slAtrMult * atr)
    _risk   = math.max(_ep - _sl, atr * 0.1)
    _tp1    = _ep + _risk * tp1R
    _tp2    = _ep + _risk * tp2R
    _tp3    = _ep + _risk * tp3R
    saved_ep  := _ep
    saved_tp1 := _tp1
    saved_tp2 := _tp2
    saved_tp3 := _tp3
    tp1_hit := false,  tp2_hit := false,  tp3_hit := false
    label.delete(lbTP1hit), lbTP1hit := na
    label.delete(lbTP2hit), lbTP2hit := na
    label.delete(lbTP3hit), lbTP3hit := na
    line.delete(lnEntry)
    lnEntry := line.new(bar_index, _ep,  bar_index + 1, _ep,  color=color.new(#FFC107, 0), width=1, style=line.style_dotted, extend=extend.right)
    line.delete(lnTP1)
    lnTP1   := line.new(bar_index, _tp1, bar_index + 1, _tp1, color=color.new(#8BC34A, 0), width=1, style=line.style_dashed, extend=extend.right)
    line.delete(lnTP2)
    lnTP2   := line.new(bar_index, _tp2, bar_index + 1, _tp2, color=color.new(#4CAF50, 0), width=1, style=line.style_dashed, extend=extend.right)
    line.delete(lnTP3)
    lnTP3   := line.new(bar_index, _tp3, bar_index + 1, _tp3, color=color.new(#009688, 0), width=1, style=line.style_dashed, extend=extend.right)

// Đánh dấu cây nến lần đầu chạm TP
if not na(saved_tp1) and showTPSL and showTPHit and trend == 1
    if not tp1_hit and high >= saved_tp1
        tp1_hit  := true
        line.delete(lnTP1),   lnTP1   := na
        label.delete(lbTP1),  lbTP1   := na
        label.delete(lbTP1hit)
        lbTP1hit := label.new(bar_index, high,
             "🎯 T1  +" + str.tostring(math.round((saved_tp1 - saved_ep) / saved_ep * 1000) / 10) + "%",
             style=label.style_label_down, color=color.new(#8BC34A, 0), textcolor=color.black, size=size.tiny)
    if not tp2_hit and high >= saved_tp2
        tp2_hit  := true
        line.delete(lnTP2),   lnTP2   := na
        label.delete(lbTP2),  lbTP2   := na
        label.delete(lbTP2hit)
        lbTP2hit := label.new(bar_index, high,
             "🎯 T2  +" + str.tostring(math.round((saved_tp2 - saved_ep) / saved_ep * 1000) / 10) + "%",
             style=label.style_label_down, color=color.new(#4CAF50, 0), textcolor=color.white, size=size.tiny)
    if not tp3_hit and high >= saved_tp3
        tp3_hit  := true
        line.delete(lnTP3),   lnTP3   := na
        label.delete(lbTP3),  lbTP3   := na
        label.delete(lbTP3hit)
        lbTP3hit := label.new(bar_index, high,
             "🎯 T3  +" + str.tostring(math.round((saved_tp3 - saved_ep) / saved_ep * 1000) / 10) + "%",
             style=label.style_label_down, color=color.new(#009688, 0), textcolor=color.white, size=size.tiny)

// SL-HT trailing theo SuperTrend support — vẽ lại mỗi khi up thay đổi
if not na(saved_ep) and showTPSL and trend == 1 and up != up[1]
    _slvn_val = up * (1 - slVnBuf / 100)
    _slvn_clr = _slvn_val >= saved_ep ? color.new(#FF9800, 0) : color.new(#2196F3, 0)
    line.delete(lnSLVN)
    lnSLVN := line.new(bar_index, _slvn_val, bar_index + 1, _slvn_val, color=_slvn_clr, width=1, style=line.style_dashed, extend=extend.right)

if barstate.islast and _tpslOn and not na(saved_ep)
    _ep        = saved_ep
    _tp1       = saved_tp1
    _tp2       = saved_tp2
    _tp3       = saved_tp3
    _tp1PctStr = str.tostring(math.round((_tp1 - _ep) / _ep * 100 * 10) / 10)
    _tp2PctStr = str.tostring(math.round((_tp2 - _ep) / _ep * 100 * 10) / 10)
    _tp3PctStr = str.tostring(math.round((_tp3 - _ep) / _ep * 100 * 10) / 10)

    label.delete(lbEntry)
    lbEntry := label.new(bar_index + 2, _ep,
         "📌 Vào:  " + f_price(_ep),
         style=label.style_label_left, color=color.new(#FFC107, 0), textcolor=color.black, size=size.small)

    if not tp1_hit
        label.delete(lbTP1)
        lbTP1 := label.new(bar_index + 2, _tp1,
             "🎯 T1:   " + f_price(_tp1) + "   +" + _tp1PctStr + "%   → chốt 20%",
             style=label.style_label_left, color=color.new(#8BC34A, 0), textcolor=color.black, size=size.small)

    if not tp2_hit
        label.delete(lbTP2)
        lbTP2 := label.new(bar_index + 2, _tp2,
             "🎯 T2:   " + f_price(_tp2) + "   +" + _tp2PctStr + "%   → chốt 30%",
             style=label.style_label_left, color=color.new(#4CAF50, 0), textcolor=color.white, size=size.small)

    if not tp3_hit
        label.delete(lbTP3)
        lbTP3 := label.new(bar_index + 2, _tp3,
             "🎯 T3:   " + f_price(_tp3) + "   +" + _tp3PctStr + "%   → chốt 40%",
             style=label.style_label_left, color=color.new(#009688, 0), textcolor=color.white, size=size.small)
    _slvn       = up * (1 - slVnBuf / 100)
    _slvnPct    = (_slvn - _ep) / _ep * 100
    _slvnSign   = _slvnPct >= 0 ? "+" : "-"
    _slvnPctStr = str.tostring(math.round(math.abs(_slvnPct) * 10) / 10)
    _slvnClr    = _slvnPct >= 0 ? color.new(#FF9800, 0) : color.new(#2196F3, 0)
    label.delete(lbSLVN)
    lbSLVN := label.new(bar_index + 2, _slvn,
         "🟠 SL : " + f_price(_slvn) + "   " + _slvnSign + _slvnPctStr + "% ",
         style=label.style_label_left, color=_slvnClr, textcolor=color.white, size=size.small)

// =========================================================
// HỖ TRỢ / KHÁNG CỰ Vũ Mạnh Đức 0973124824
// =========================================================
var line  lSR  = line.new(na, na, na, na)
var label lbSR = label.new(na, na, "", color=color.green, textcolor=color.white, style=label.style_label_left, size=size.small)

if showSR
    srPrice = trend == 1 ? up : dn
    srColor = trend == 1 ? color.green : color.red
    if trend != trend[1]
        line.delete(lSR)
        lSR := line.new(bar_index, srPrice, bar_index + 20, srPrice,
             color=srColor, width=1, style=line.style_dashed, extend=extend.right)
    line.set_xy1(lSR, bar_index,      srPrice)
    line.set_xy2(lSR, bar_index + 12, srPrice)
    line.set_color(lSR, srColor)
    label.set_xy(lbSR,   bar_index + 12, srPrice)
    label.set_text(lbSR, (trend == 1 ? "HT: " : "KC: ") + f_price(srPrice))
    label.set_color(lbSR, srColor)

// =========================================================
// VÙNG MUA/BÁN THEO KHỐI LƯỢNG — GỌI HÀM & HIỂN THỊ
// =========================================================
[vsr_supLvl, vsr_resLvl,
     vsr_brkRes, vsr_hldRes,
         vsr_hldSup, vsr_brkSup] = _vsr_calc(close, vsr_lookback)

var bool vsr_resIsSup = false
var bool vsr_supIsRes = false

switch
    vsr_brkRes => vsr_resIsSup := true
    vsr_hldRes => vsr_resIsSup := false

switch
    vsr_brkSup => vsr_supIsRes := true 
    vsr_hldSup => vsr_supIsRes := false

plotshape(showVolSR and vsr_hldRes,                       "KC giữ vững",     shape.diamond, location.abovebar, color.new(#e92929, 0), size=size.tiny, offset=-1)
plotshape(showVolSR and vsr_hldSup,                       "HT giữ vững",     shape.diamond, location.belowbar, color.new(#20ca26, 0), size=size.tiny, offset=-1)
plotshape(showVolSR and vsr_brkRes and vsr_resIsSup[1],   "KC đổi thành HT", shape.diamond, location.belowbar, color.new(#20ca26, 0), size=size.tiny, offset=-1)
plotshape(showVolSR and vsr_brkSup and vsr_supIsRes[1],   "HT đổi thành KC", shape.diamond, location.abovebar, color.new(#e92929, 0), size=size.tiny, offset=-1)

if showVolSR and vsr_brkSup and not vsr_supIsRes[1]
    label.new(bar_index[1], vsr_supLvl[1], "Phá HT",
         style=label.style_label_down, color=color.new(#7e1e1e, 0), textcolor=chart.fg_color, size=size.small)

if showVolSR and vsr_brkRes and not vsr_resIsSup[1]
    label.new(bar_index[1], vsr_resLvl[1], "Phá KC",
         style=label.style_label_up, color=color.new(#2b6d2d, 0), textcolor=chart.fg_color, size=size.small)

// =========================================================
// 2 ĐƯỜNG DỌC VÙNG BACKTEST Vũ Mạnh Đức 0973124824
// =========================================================
var line  lineStart = na
var line  lineEnd   = na
var label lblStart  = na
var label lblEnd    = na

if showZoneLines and showHistory
    if time == startTime or (time > startTime and time[1] < startTime)
        line.delete(lineStart), label.delete(lblStart)
        lineStart := line.new(bar_index, low * 0.95, bar_index, high * 1.05,
             color=color.new(#00E676, 0), width=2, style=line.style_dashed, extend=extend.both)
        lblStart  := label.new(bar_index, high, "▶ BẮT ĐẦU\n" + str.format_time(startTime, "dd/MM/yyyy"),
             style=label.style_label_down, color=color.new(#00E676, 0), textcolor=color.white, size=size.small)
    if useEndTime and (time == endTime or (time > endTime and time[1] < endTime))
        line.delete(lineEnd), label.delete(lblEnd)
        lineEnd := line.new(bar_index, low * 0.95, bar_index, high * 1.05,
             color=color.new(#FF5252, 0), width=2, style=line.style_dashed, extend=extend.both)
        lblEnd  := label.new(bar_index, high, "⏹ KẾT THÚC\n" + str.format_time(endTime, "dd/MM/yyyy"),
             style=label.style_label_down, color=color.new(#FF5252, 0), textcolor=color.white, size=size.small)

// =========================================================
// BACKTEST Vũ Mạnh Đức 0973124824
// =========================================================
inBacktest = showHistory and time >= startTime and (not useEndTime or time <= endTime)

var array<string> hist_buyDate   = array.new<string>()
var array<float>  hist_buyPrice  = array.new<float>()
var array<string> hist_sellDate  = array.new<string>()
var array<float>  hist_sellPrice = array.new<float>()
var array<float>  hist_pnlPct    = array.new<float>()
var array<float>  hist_pnlAmount = array.new<float>()
var array<int>    hist_holdDays  = array.new<int>()

var float  bt_entryPrice  = na
var int    bt_entryBar    = 0
var string bt_entryDate   = ""
var int    bt_totalTrades = 0
var int    bt_winTrades   = 0
var int    bt_lossTrades  = 0
var float  bt_totalPnL    = 0.0
var float  bt_capital     = initialCapital
var float  bt_maxCapital  = initialCapital
var float  bt_maxDrawdown = 0.0
var int    bt_totalDays   = 0

if inBacktest and buySignal and na(bt_entryPrice)
    bt_entryPrice := f_buyPrice(entryMode)
    bt_entryBar   := bar_index
    bt_entryDate  := f_today()

if inBacktest and sellSignal and not na(bt_entryPrice)
    exitPrice   = f_sellPrice(entryMode)
    holdDays    = bar_index - bt_entryBar
    pnlPct      = (exitPrice - bt_entryPrice) / bt_entryPrice * 100
    pnlAmt      = (compoundMode ? bt_capital : initialCapital) * pnlPct / 100

    array.push(hist_buyDate,   bt_entryDate)
    array.push(hist_buyPrice,  bt_entryPrice)
    array.push(hist_sellDate,  f_today())
    array.push(hist_sellPrice, exitPrice)
    array.push(hist_pnlPct,    pnlPct)
    array.push(hist_pnlAmount, pnlAmt)
    array.push(hist_holdDays,  holdDays)

    bt_capital     := bt_capital + pnlAmt
    bt_maxCapital  := math.max(bt_maxCapital, bt_capital)
    bt_maxDrawdown := math.min(bt_maxDrawdown, (bt_capital - bt_maxCapital) / bt_maxCapital * 100)
    bt_totalTrades += 1
    bt_totalPnL    += pnlPct
    bt_totalDays   += holdDays
    bt_winTrades   += pnlPct > 0  ? 1 : 0
    bt_lossTrades  += pnlPct <= 0 ? 1 : 0
    bt_entryPrice  := na
    bt_entryBar    := 0
    bt_entryDate   := ""

bt_winRate   = bt_totalTrades > 0 ? bt_winTrades / bt_totalTrades * 100 : 0.0
bt_avgPnL    = bt_totalTrades > 0 ? bt_totalPnL  / bt_totalTrades       : 0.0
bt_netProfit = bt_capital - initialCapital
bt_returnPct = initialCapital > 0 ? bt_netProfit / initialCapital * 100  : 0.0

// =========================================================
// BẢNG LỊCH SỬ GIAO DỊCH Vũ Mạnh Đức 0973124824
// =========================================================
tSize = f_tsize(tableSize)

if barstate.islast and showHistory and array.size(hist_buyDate) > 0
    tbl_pos      = tablePosition == "bottom_right" ? position.bottom_right : tablePosition == "bottom_center" ? position.bottom_center : position.bottom_left
    tSize_h      = tableSize == "tiny" ? size.small : tableSize == "small" ? size.normal : tableSize == "normal" ? size.large : size.huge
    tSize_d      = tableSize == "tiny" ? size.tiny  : tableSize == "small" ? size.small  : tableSize == "normal" ? size.normal : size.large
    totalTrades  = array.size(hist_buyDate)
    displayCount = math.min(totalTrades, maxHistoryRows)
    startIdx     = math.max(0, totalTrades - displayCount)

    float disp_totalPct  = 0.0
    float disp_totalAmt  = 0.0
    int   disp_totalDays = 0
    float disp_sumBuy    = 0.0
    float disp_sumSell   = 0.0
    for i = 0 to displayCount - 1
        disp_totalPct  += array.get(hist_pnlPct,    startIdx + i)
        disp_totalAmt  += array.get(hist_pnlAmount, startIdx + i)
        disp_totalDays += array.get(hist_holdDays,  startIdx + i)
        disp_sumBuy    += array.get(hist_buyPrice,  startIdx + i)
        disp_sumSell   += array.get(hist_sellPrice, startIdx + i)

    disp_avgBuy  = disp_sumBuy  / displayCount
    disp_avgSell = disp_sumSell / displayCount
    avgDaysD     = disp_totalDays / displayCount

    htbl = table.new(tbl_pos, 8, 4 + displayCount + 4,
         bgcolor=T_BG_DRK, border_width=1, border_color=T_BRD, frame_width=2, frame_color=T_BRD)
    r = 0

    // ── HEADER ───────────────────────────────────────────────
    endLabel  = useEndTime ? " → " + str.format_time(endTime, "dd/MM/yyyy") : " → Hiện tại"
    modeLabel = compoundMode ? "] ♻️ Xoay vốn" : " ] 📦 Vốn cố định"
    table.cell(htbl, 0, r, "📌 " + syminfo.ticker + "  [" + str.format_time(startTime, "dd/MM/yyyy") + endLabel + modeLabel,
         text_color=T_WHT, text_size=tSize_h, text_halign=text.align_center, bgcolor=T_HDR)
    for i = 1 to 7
        table.cell(htbl, i, r, "", bgcolor=T_HDR)
    table.merge_cells(htbl, 0, r, 7, r)
    r += 1

    // ── INFO ROW ─────────────────────────────────────────────
    table.cell(htbl, 0, r, "Hiển thị " + str.tostring(displayCount) + "/" + str.tostring(totalTrades) + " giao dịch gần nhất",
         text_color=T_YLW, text_size=tSize_d, text_halign=text.align_center, bgcolor=T_BG_LGT)
    for i = 1 to 7
        table.cell(htbl, i, r, "", bgcolor=T_BG_LGT)
    table.merge_cells(htbl, 0, r, 7, r)
    r += 1

    // ── HEADER CỘT ───────────────────────────────────────────
    table.cell(htbl, 0, r, "#",           text_color=T_WHT, text_size=tSize_d, text_halign=text.align_center, bgcolor=T_HDR)
    table.cell(htbl, 1, r, "NGÀY VÀO",    text_color=T_WHT, text_size=tSize_d, text_halign=text.align_center, bgcolor=T_HDR)
    table.cell(htbl, 2, r, "GIÁ VÀO",     text_color=T_WHT, text_size=tSize_d, text_halign=text.align_center, bgcolor=T_HDR)
    table.cell(htbl, 3, r, "NGÀY THOÁT",  text_color=T_WHT, text_size=tSize_d, text_halign=text.align_center, bgcolor=T_HDR)
    table.cell(htbl, 4, r, "GIÁ THOÁT",   text_color=T_WHT, text_size=tSize_d, text_halign=text.align_center, bgcolor=T_HDR)
    table.cell(htbl, 5, r, "PHIÊN GIỮ",   text_color=T_WHT, text_size=tSize_d, text_halign=text.align_center, bgcolor=T_HDR)
    table.cell(htbl, 6, r, "TIỀN LÃI/LỖ", text_color=T_WHT, text_size=tSize_d, text_halign=text.align_center, bgcolor=T_HDR)
    table.cell(htbl, 7, r, "KẾT QUẢ %",   text_color=T_WHT, text_size=tSize_d, text_halign=text.align_center, bgcolor=T_HDR)
    r += 1

    // ── DỮ LIỆU TỪNG LỆNH ────────────────────────────────────
    for i = 0 to displayCount - 1
        idx    = startIdx + i
        pnlPct = array.get(hist_pnlPct,    idx)
        pnlAmt = array.get(hist_pnlAmount, idx)
        rowBg  = i % 2 == 0 ? T_BG_DRK : T_BG_LGT
        pnlClr = pnlPct >= 0 ? T_GRN : T_RED
        table.cell(htbl, 0, r, str.tostring(idx + 1),                                                text_color=T_LBL,  text_size=tSize_d, text_halign=text.align_center, bgcolor=rowBg)
        table.cell(htbl, 1, r, array.get(hist_buyDate,   idx),                                       text_color=T_VAL,  text_size=tSize_d, text_halign=text.align_center, bgcolor=rowBg)
        table.cell(htbl, 2, r, f_price(array.get(hist_buyPrice,  idx)),                              text_color=T_VAL,  text_size=tSize_d, text_halign=text.align_right,  bgcolor=rowBg)
        table.cell(htbl, 3, r, array.get(hist_sellDate,  idx),                                       text_color=T_VAL,  text_size=tSize_d, text_halign=text.align_center, bgcolor=rowBg)
        table.cell(htbl, 4, r, f_price(array.get(hist_sellPrice, idx)),                              text_color=T_VAL,  text_size=tSize_d, text_halign=text.align_right,  bgcolor=rowBg)
        table.cell(htbl, 5, r, str.tostring(array.get(hist_holdDays, idx)),                          text_color=T_LBL,  text_size=tSize_d, text_halign=text.align_center, bgcolor=rowBg)
        table.cell(htbl, 6, r, f_sign(pnlAmt) + f_million(pnlAmt) + " tr",                          text_color=pnlClr, text_size=tSize_d, text_halign=text.align_right,  bgcolor=rowBg)
        table.cell(htbl, 7, r, f_pct(pnlPct),                                                       text_color=pnlClr, text_size=tSize_d, text_halign=text.align_center, bgcolor=rowBg)
        r += 1

    // ── HÀNG TỔNG CỘNG ───────────────────────────────────────
    totClr = disp_totalAmt >= 0 ? T_GRN : T_RED
    table.cell(htbl, 0, r, "TỔNG",                                                                            text_color=T_YLW,  text_size=tSize_d, text_halign=text.align_center, bgcolor=T_BG_TOT)
    table.cell(htbl, 1, r, "-",                                                                               text_color=T_YLW,  text_size=tSize_d, text_halign=text.align_center, bgcolor=T_BG_TOT)
    table.cell(htbl, 2, r, f_price(disp_avgBuy),                                                             text_color=T_YLW,  text_size=tSize_d, text_halign=text.align_right,  bgcolor=T_BG_TOT)
    table.cell(htbl, 3, r, "-",                                                                               text_color=T_YLW,  text_size=tSize_d, text_halign=text.align_center, bgcolor=T_BG_TOT)
    table.cell(htbl, 4, r, f_price(disp_avgSell),                                                            text_color=T_YLW,  text_size=tSize_d, text_halign=text.align_right,  bgcolor=T_BG_TOT)
    table.cell(htbl, 5, r, str.tostring(math.round(avgDaysD)),                                               text_color=T_YLW,  text_size=tSize_d, text_halign=text.align_center, bgcolor=T_BG_TOT)
    table.cell(htbl, 6, r, f_sign(disp_totalAmt) + f_million(disp_totalAmt) + " tr",                        text_color=totClr, text_size=tSize_d, text_halign=text.align_right,  bgcolor=T_BG_TOT)
    table.cell(htbl, 7, r, f_pct(disp_totalPct),                                                          text_color=totClr, text_size=tSize_d, text_halign=text.align_center, bgcolor=T_BG_TOT)
    r += 1

    // ── SUMMARY ROW 1: Vốn & Lãi/Lỗ ─────────────────────────
    finalPnlColor = bt_netProfit >= 0 ? T_GRN : T_RED
    table.cell(htbl, 0, r, "Vốn đầu: " + f_million(initialCapital) + "tr → Vốn cuối: " + f_million(bt_capital) + " tr",
         text_color=T_VAL, text_size=tSize_d, text_halign=text.align_left, bgcolor=T_BG_DRK)
    for i = 1 to 2
        table.cell(htbl, i, r, "", bgcolor=T_BG_DRK)
    table.merge_cells(htbl, 0, r, 2, r)
    table.cell(htbl, 3, r, "Lãi/Lỗ: " + f_sign(bt_netProfit) + f_million(bt_netProfit) + " tr | ROI: " + f_pct(bt_returnPct),
         text_color=finalPnlColor, text_size=tSize_d, text_halign=text.align_left, bgcolor=T_BG_DRK)
    for i = 4 to 7
        table.cell(htbl, i, r, "", bgcolor=T_BG_DRK)
    table.merge_cells(htbl, 3, r, 7, r)
    r += 1

    // ── SUMMARY ROW 2: Lệnh & Win Rate & Max DD ───────────────
    wrClr = bt_winRate >= 50 ? T_GRN : bt_winRate >= 40 ? T_YLW : T_RED
    table.cell(htbl, 0, r, "Có " + str.tostring(bt_totalTrades) + " giao dịch: ✅ " + str.tostring(bt_winTrades) + " thắng, ❌ " + str.tostring(bt_lossTrades) + " thua",
         text_color=T_VAL, text_size=tSize_d, text_halign=text.align_left, bgcolor=T_BG_LGT)
    for i = 1 to 2
        table.cell(htbl, i, r, "", bgcolor=T_BG_LGT)
    table.merge_cells(htbl, 0, r, 2, r)
    table.cell(htbl, 3, r, "Win Rate: " + str.tostring(f_round2(bt_winRate)) + "% | Avg PnL: " + f_pct(bt_avgPnL),
         text_color=wrClr, text_size=tSize_d, text_halign=text.align_left, bgcolor=T_BG_LGT)
    for i = 4 to 6
        table.cell(htbl, i, r, "", bgcolor=T_BG_LGT)
    table.merge_cells(htbl, 3, r, 6, r)
    table.cell(htbl, 7, r, "📉 Max DD: " + str.tostring(f_round2(bt_maxDrawdown)) + "%",
         text_color=T_RED, text_size=tSize_d, text_halign=text.align_right, bgcolor=T_BG_LGT)
    r += 1

    // ── DISCLAIMER ───────────────────────────────────────────
    table.cell(htbl, 0, r, "⚠️ Kết quả quá khứ không đảm bảo hiệu suất tương lai",
         text_color=T_YLW, text_size=tSize_d, text_halign=text.align_center, bgcolor=T_BG_DRK)
    for i = 1 to 7
        table.cell(htbl, i, r, "", bgcolor=T_BG_DRK)
    table.merge_cells(htbl, 0, r, 7, r)

// =========================================================
// BẢNG TÍN HIỆU GÓC PHẢI Vũ Mạnh Đức 0973124824
// =========================================================
var table stbl = table.new(position.top_right, 3, 5,
     bgcolor=na, border_width=0, frame_width=0)

_ssLiqBil  = _ss_avgValue / 1000000000
_ssLiqTxt  = (_ss_liquid ? "✅" : "❌") + " Thanh khoản: " + str.tostring(_ssLiqBil, "#.#") + " tỷ/ngày (cần ≥" + str.tostring(ssLiqThresh, "#") + " tỷ)"
_ssTooltip = "TIÊU CHÍ SIÊU CỔ PHIẾU (cần ≥5/7) — " + str.tostring(superScore) + "/7\n" +
     _ssLiqTxt                                                                        + "\n" +
     "──────────────────────\n" +
     (_ss1 ? "✅" : "❌") + " Giá > EMA200\n" +
     (_ss2 ? "✅" : "❌") + " EMA200 đang tăng\n" +
     (_ss3 ? "✅" : "❌") + " Gần/phá đỉnh 52 tuần (≥90%)\n" +
     (_ss4 ? "✅" : "❌") + " EMA50 > EMA200 (Golden Align)\n" +
     (_ss5 ? "✅" : "❌") + " Giá > EMA50\n" +
     (_ss6 ? "✅" : "❌") + " ADX > 25 (xu hướng mạnh)\n" +
     (_ss7 ? "✅" : "❌") + " Volume đang nở rộng"

if showTable
    pnlR      = math.round(pnl * 100) / 100
    pnlAbs    = str.tostring(math.abs(pnlR)) + "%"
    pnlTxt    = signalType == "HẾT TREND" ? (pnlR >= 0 ? "-" + pnlAbs : "+" + pnlAbs) : (pnlR >= 0 ? "+" + pnlAbs : "-" + pnlAbs)
    _sigTypeD = signalType == "VÀO TREND" ? "vào trend" : "hết trend"
    srPrc     = trend == 1 ? up : dn
    srLbl     = trend == 1 ? "Hỗ trợ" : "Kháng cự"
    _liqDay    = close * volume / 1000000000
    _liqDayTxt = "Thanh khoản: " + str.tostring(_liqDay, "#.#") + " tỷ"

    _clrDateSig = trend == 1 ? clrDateSigUp : clrDateSigDown
    _clrDateNow = trend == 1 ? clrDateNowUp : clrDateNowDown
    _clrLiq     = trend == 1 ? clrLiqUp     : clrLiqDown
    _clrSR      = trend == 1 ? clrSRUp      : clrSRDown
    _clrStatus  = trend == 1 ? clrStatusUp  : clrStatusDown
    _ssHdrTc  = isSuperStock ? (isDark ? color.new(#FFD700, 0) : color.new(#B8860B, 0)) : clrTableTicker

    // Hàng đệm — đẩy bảng xuống theo số dòng người dùng nhập, không sát viền trên
    _gapTxt = ""
    if tableTopGap > 0
        for _i = 1 to tableTopGap
            _gapTxt := _gapTxt + "\n"
    table.cell(stbl, 0, 0, _gapTxt, bgcolor=na, text_size=size.tiny)
    table.cell(stbl, 1, 0, _gapTxt, bgcolor=na, text_size=size.tiny)
    table.cell(stbl, 2, 0, _gapTxt, bgcolor=na, text_size=size.tiny)

    // Cột 0 — mã CK, trải dài 3 hàng chi tiết
    table.cell(stbl, 0, 1, syminfo.ticker,
         text_color=_ssHdrTc, text_size=size.huge, text_halign=text.align_right, bgcolor=na, text_formatting=text.format_bold, tooltip=_ssTooltip)
    table.cell(stbl, 0, 2, "", bgcolor=na)
    table.cell(stbl, 0, 3, "", bgcolor=na)
    table.merge_cells(stbl, 0, 1, 0, 3)

    // Hàng 1 — ngày & giá tín hiệu
    table.cell(stbl, 1, 1, "Ngày " + _sigTypeD + ": " + signalDate,          text_color=_clrDateSig, text_size=tSize, text_halign=text.align_left, bgcolor=na, text_formatting=text.format_bold)
    table.cell(stbl, 2, 1, "Giá " + _sigTypeD + ": " + f_price(signalPrice), text_color=_clrDateSig, text_size=tSize, text_halign=text.align_left, bgcolor=na, text_formatting=text.format_bold)

    // Hàng 2 — ngày & giá hiện tại
    table.cell(stbl, 1, 2, "Ngày hiện tại: " + f_today(),        text_color=_clrDateNow, text_size=tSize, text_halign=text.align_left, bgcolor=na, text_formatting=text.format_bold)
    table.cell(stbl, 2, 2, "Giá hiện tại: " + f_price(close),    text_color=_clrDateNow, text_size=tSize, text_halign=text.align_left, bgcolor=na, text_formatting=text.format_bold)

    // Hàng 3 — thanh khoản & hỗ trợ/kháng cự
    table.cell(stbl, 1, 3, _liqDayTxt,                     text_color=_clrLiq, text_size=tSize, text_halign=text.align_left, bgcolor=na, text_formatting=text.format_bold)
    table.cell(stbl, 2, 3, srLbl + ": " + f_price(srPrc), text_color=_clrSR, text_size=tSize, text_halign=text.align_left, bgcolor=na, text_formatting=text.format_bold)

    // Hàng 4 — trạng thái, chỉ chiếm 2 cột phải, không lấn xuống dưới ticker
    _statusTxt = (trend == 1 ? "▲ Đang trong trend tăng" : "▼ Đang trong trend giảm") +
         "\n" + (trend == 1
         ? "Nắm giữ " + str.tostring(signalCount) + " phiên, đã lãi " + pnlTxt
         : "Đứng ngoài " + str.tostring(signalCount) + " phiên, tránh lỗ " + pnlTxt)
    table.cell(stbl, 0, 4, "", bgcolor=na)
    table.cell(stbl, 1, 4, _statusTxt, text_color=_clrStatus, text_size=tSize, text_halign=text.align_center, bgcolor=na, text_formatting=text.format_bold)
    table.cell(stbl, 2, 4, "", bgcolor=na)
    table.merge_cells(stbl, 1, 4, 2, 4)

// =========================================================
// CON TRỎ THỜI GIAN Vũ Mạnh Đức 0973124824
// =========================================================
var line  lnTC = na
var label lbTC = na

if barstate.islast and showTimeCursor
    line.delete(lnTC)
    label.delete(lbTC)
    if not na(tc_entryPrice) and not na(tc_cursorBar) and not na(tc_closeRef)
        _tc_pnl    = tc_entryPrice == 0 ? 0.0 :
             tc_type == "VÀO TREND" ? (tc_closeRef - tc_entryPrice) / tc_entryPrice * 100 :
             (tc_entryPrice - tc_closeRef) / tc_entryPrice * 100
        _tc_pnlR   = math.round(_tc_pnl * 100) / 100
        _tc_pnlAbs = str.tostring(math.abs(_tc_pnlR)) + "%"
        _tc_pnlTxt = tc_type == "HẾT TREND" ? (_tc_pnlR >= 0 ? "-" + _tc_pnlAbs : "+" + _tc_pnlAbs) :
             (_tc_pnlR >= 0 ? "+" + _tc_pnlAbs : "-" + _tc_pnlAbs)
        _tc_pnlLbl = tc_type == "VÀO TREND" ? (_tc_pnlR >= 0 ? "✅ ĐANG LÃI" : "❌ ĐANG LỖ") : "📊 TRÁNH LỖ"
        _tc_bgClr  = _tc_pnlR >= 0 ? color.new(#4CAF50, 15) : color.new(#F44336, 15)

        lnTC := line.new(tc_cursorBar, low * 0.96, tc_cursorBar, high * 1.04,
             color=color.new(#FFC107, 0), width=2, style=line.style_dashed, extend=extend.both)


        // Ghi đè bảng tín hiệu góc phải với dữ liệu tại thời điểm con trỏ
        if showTable
            _tc_typeD       = tc_type == "VÀO TREND" ? "vào trend" : "hết trend"
            _tc_srLbl       = tc_trend == 1 ? "Hỗ trợ" : "Kháng cự"
            _tc_liqTxt      = "Thanh khoản: " + str.tostring(tc_liqDay / 1000000000, "#.#") + " tỷ"
            _tc_clrDateSig  = tc_trend == 1 ? clrDateSigUp : clrDateSigDown
            _tc_clrLiq      = tc_trend == 1 ? clrLiqUp     : clrLiqDown
            _tc_clrSR       = tc_trend == 1 ? clrSRUp      : clrSRDown
            _tc_clrStatus   = tc_trend == 1 ? clrStatusUp  : clrStatusDown

            // Cột 0 — mã CK, trải dài 3 hàng chi tiết
            table.cell(stbl, 0, 1, syminfo.ticker,
                 text_color=clrTableTicker, text_size=size.huge, text_halign=text.align_right, bgcolor=na, text_formatting=text.format_bold, tooltip=_ssTooltip)
            table.cell(stbl, 0, 2, "", bgcolor=na)
            table.cell(stbl, 0, 3, "", bgcolor=na)
            table.merge_cells(stbl, 0, 1, 0, 3)

            // Hàng 1 — ngày & giá tín hiệu
            table.cell(stbl, 1, 1, "Ngày " + _tc_typeD + ": " + tc_date,               text_color=_tc_clrDateSig, text_size=tSize, text_halign=text.align_left, bgcolor=na, text_formatting=text.format_bold)
            table.cell(stbl, 2, 1, "Giá " + _tc_typeD + ": " + f_price(tc_entryPrice), text_color=_tc_clrDateSig, text_size=tSize, text_halign=text.align_left, bgcolor=na, text_formatting=text.format_bold)

            // Hàng 2 — ngày & giá xem lại
            table.cell(stbl, 1, 2, "Ngày xem lại: " + str.format_time(cursorTime, "dd/MM/yyyy"), text_color=clrTableReview, text_size=tSize, text_halign=text.align_left, bgcolor=na, text_formatting=text.format_bold)
            table.cell(stbl, 2, 2, "Giá xem lại: " + f_price(tc_closeRef),                        text_color=clrTableReview, text_size=tSize, text_halign=text.align_left, bgcolor=na, text_formatting=text.format_bold)

            // Hàng 3 — thanh khoản & hỗ trợ/kháng cự
            table.cell(stbl, 1, 3, _tc_liqTxt,                             text_color=_tc_clrLiq, text_size=tSize, text_halign=text.align_left, bgcolor=na, text_formatting=text.format_bold)
            table.cell(stbl, 2, 3, _tc_srLbl + ": " + f_price(tc_srPrice), text_color=_tc_clrSR, text_size=tSize, text_halign=text.align_left, bgcolor=na, text_formatting=text.format_bold)

            // Hàng 4 — trạng thái, chiếm trọn chiều ngang
            _tc_statusTxt = (tc_trend == 1 ? "▲ Đang trong trend tăng" : "▼ Đang trong trend giảm") +
                 "\n" + (tc_trend == 1
                 ? "Nắm giữ " + str.tostring(tc_holdCount) + " phiên, đã lãi " + _tc_pnlTxt
                 : "Đứng ngoài " + str.tostring(tc_holdCount) + " phiên, tránh lỗ " + _tc_pnlTxt)
            table.cell(stbl, 0, 4, "", bgcolor=na)
            table.cell(stbl, 1, 4, _tc_statusTxt, text_color=_tc_clrStatus, text_size=tSize, text_halign=text.align_center, bgcolor=na, text_formatting=text.format_bold)
            table.cell(stbl, 2, 4, "", bgcolor=na)
            table.merge_cells(stbl, 1, 4, 2, 4)

// =========================================================
// =========================================================
var label lbStar = na

if barstate.islast
    label.delete(lbStar)
    lbStar := label.new(
         x         = bar_index,
         y         = trend == 1 ? up : dn,
         text      = isSuperStock ? "💎" : "✪",
         style     = label.style_label_center,
         color     = color.new(color.black, 100),
         textcolor = isSuperStock ? color.new(#FFD700, 0) : (trend == 1 ? color.new(color.green, 0) : color.new(color.red, 0)),
         size      = size.large)

// =========================================================
// AI KHUYẾN NGHỊ GẮN VÀO SUPERTREND Vũ Mạnh Đức 0973124824
// =========================================================
var label lbVol = na

if barstate.islast and showVolLabel
    label.delete(lbVol)

    // isBreakUp   = buySignal  and biasNorm >= 55 and delta_vol_pct >  20
    // isBreakDown = sellSignal and biasNorm <= 45 and delta_vol_pct < -20
    srAnchor    = trend == 1 ? up : dn
    lblStyle = trend == 1 ? label.style_label_upper_left : label.style_label_lower_left

    trendClr = isSuperStock and trend == 1 ? color.new(#B8860B, 10) :
         buySignal  ? color.new(color.purple, 10) :
         sellSignal ? color.new(color.orange, 10) :
         trend == 1 ? color.new(color.green,  25) :
                      color.new(color.red,    25)

    // Tóm tắt chỉ báo
    rsiTxt  = "RSI:"  + str.tostring(math.round(rsiVal)) + (rsiVal > 52 ? "↑" : rsiVal < 48 ? "↓" : "→")
    macdTxt = "MACD:" + (macdHist > 0 and macdHist > macdHistPrev ? "↑" : macdHist < 0 and macdHist < macdHistPrev ? "↓" : "→")
    adxTxt  = "ADX:"  + str.tostring(math.round(adx)) + (adx > 20 ? "💪" : "😴")
    obvTxt  = "OBV:"  + (obvVal > obvEma  ? "↑" : "↓")
    emaTxt  = "EMA:"  + (ema9   > ema21   ? "9>21↑" : "9<21↓")
    vwapTxt = "VWAP:" + (close  > vwapV   ? "↑" : "↓")

    volRatio = volume / volAvg
    volTxt   = volRatio >= 2.0 ? "🔥 " + str.tostring(math.round(volRatio * 10) / 10) + "x — Đột biến!" :
               volRatio >= 1.5 ? "⚡ " + str.tostring(math.round(volRatio * 10) / 10) + "x — Cao"        :
               volRatio >= 0.8 ?         str.tostring(math.round(volRatio * 10) / 10) + "x — Bình thường":
                                          str.tostring(math.round(volRatio * 10) / 10) + "x — Thấp"

    deltaSign = delta_vol_pct >= 0 ? "+" : ""
    deltaTxt  = deltaSign + str.tostring(math.round(delta_vol_pct * 10) / 10) + "%"

    // === RISK MANAGEMENT ===
    profitTxt = ""
    if signalType == "VÀO TREND" and not na(signalPrice) and trend == 1
        if not na(saved_tp1)
            _pt1Pct = str.tostring(math.round((saved_tp1 - saved_ep) / saved_ep * 1000) / 10)
            _pt2Pct = str.tostring(math.round((saved_tp2 - saved_ep) / saved_ep * 1000) / 10)
            _pt3Pct = str.tostring(math.round((saved_tp3 - saved_ep) / saved_ep * 1000) / 10)
            if close >= saved_tp3
                profitTxt := "🎯 Đã đạt T3 (+" + _pt3Pct + "%) tại " + f_price(saved_tp3) + "\n" +
                             "👉 Chốt thêm 40% — còn 10% gồng trailing stop"
            else if close >= saved_tp2
                profitTxt := "🎯 Đã đạt T2 (+" + _pt2Pct + "%) tại " + f_price(saved_tp2) + "\n" +
                             "👉 Chốt thêm 30% — còn 50% → gồng đến T3: " + f_price(saved_tp3) + " (+" + _pt3Pct + "%)"
            else if close >= saved_tp1
                profitTxt := "🎯 Đã đạt T1 (+" + _pt1Pct + "%) tại " + f_price(saved_tp1) + "\n" +
                             "👉 Chốt 20% — còn 80% → giữ đến T2: " + f_price(saved_tp2) + " (+" + _pt2Pct + "%)"
            else
                profitTxt := "🎯 T1 nhắm đến: " + f_price(saved_tp1) + " (+" + _pt1Pct + "%) → chốt 20% vị thế"
        else
            price20 = signalPrice * 1.20
            price40 = signalPrice * 1.40
            price80 = signalPrice * 1.80
            if close >= price80
                profitTxt := "🎯 Đã đạt T3 (+80%) tại " + f_price(price80) + "\n" +
                             "👉 Xuất sắc! Cân nhắc chốt toàn bộ hoặc đặt trailing stop"
            else if close >= price40
                profitTxt := "🎯 Đã đạt T2 (+40%) tại " + f_price(price40) + "\n" +
                             "👉 Lãi đẹp! Có thể chốt thêm 40%, gồng phần cuối đến T3: " + f_price(price80)
            else if close >= price20
                profitTxt := "🎯 Đã đạt T1 (+20%) tại " + f_price(price20) + "\n" +
                             "👉 Gợi ý chốt 30%, để phần còn lại chạy đến T2: " + f_price(price40)
            else
                profitTxt := "🎯 T1 nhắm đến: " + f_price(price20) + " — Có thể chốt 1/3 vị thế"
    
    recTxt = buySignal  ? "🚀 Tín hiệu bứt phá xác nhận \n    └  Thời điểm vào trend tốt" :
         sellSignal  ? "⚠️ Xu hướng đảo chiều \n    └  Nên thoát trend, bảo toàn vốn" :
         trend == 1  and biasNorm >= 55 and delta_vol_pct >  0 ? "📈 Dòng tiền vào tốt, xu hướng ủng hộ \n    └  Tiếp tục nắm giữ" :
         trend == 1  and biasNorm >= 55 and delta_vol_pct <= 0 ? "👀 Momentum đang chậm lại \n    └  Giữ nhưng quan sát kỹ" :
         trend == 1  and biasNorm <  55                        ? "⚠️ Tín hiệu chưa đồng thuận \n    └  Chưa nên tăng tỷ trọng" :
         trend == -1 and biasNorm <= 45 and delta_vol_pct <  0 ? "⛔ Áp lực bán còn chiếm ưu thế \n    └  Đứng ngoài quan sát" :
         trend == -1 and biasNorm <= 45 and delta_vol_pct >= 0 ? "🔍 Có dấu hiệu hồi kỹ thuật \n    └  Chưa đủ xác nhận, chờ thêm" :
                                                                 "⚖️ Thị trường tích lũy \n    └  Chờ breakout mới vào lệnh"

    // === VỊ NẾN GẦN ĐỈNH/ĐÁY ===
    _body   = math.abs(close - open)
    _range  = high - low
    _upWick = high - math.max(close, open)
    _dnWick = math.min(close, open) - low
    _srLvl  = trend == 1 ? up : dn
    _nearSR = _range > 0 and math.abs(close - _srLvl) / _srLvl * 100 <= nearThreshPct

    candlePatternTxt = ""
    _cp = ""
    _cs = ""

    if showCandlePattern and _nearSR
        if trend == 1
            if close[2] < open[2] and math.abs(close[1] - open[1]) <= math.abs(close[2] - open[2]) * 0.5 and close > open and close > (open[2] + close[2]) / 2
                _cp := "🌟 Morning Star"
                _cs := "3 nến đảo chiều tăng — phe mua kiểm soát sau phe bán kiệt sức"
            else if _body > 0 and _dnWick >= 2 * _body and _upWick <= 0.5 * _body
                _cp := "🔨 Hammer"
                _cs := "Đuôi dài dưới — khả năng bật lại từ hỗ trợ"
            else if _body > 0 and _upWick >= 2 * _body and _dnWick <= 0.5 * _body
                _cp := "🔃 Inverted Hammer"
                _cs := "Đuôi dài trên tại đáy — phe mua đang thăm dò phục hồi"
            else if close > open and close[1] < open[1] and open <= close[1] and close >= open[1]
                _cp := "🕯️ Bullish Engulfing"
                _cs := "Nến tăng bao phủ nến giảm — đảo chiều tăng"
            else if close > open and close[1] < open[1] and open < close[1] and close > (open[1] + close[1]) / 2 and close < open[1]
                _cp := "🌤️ Piercing Line"
                _cs := "Nến tăng xuyên giữa nến giảm trước — tín hiệu đảo chiều tăng"
            else if _range > 0 and _body / _range < 0.1 and _dnWick >= _upWick * 1.5
                _cp := "🌅 Dragonfly Doji"
                _cs := "Doji đuôi dài dưới — chú ý đảo chiều tăng"
            else if _range > 0 and _body / _range < 0.15
                _cp := "〰️ Doji"
                _cs := "Giằng co tại hỗ trợ — chờ xác nhận"
            else if close > open and close[1] > open[1] and close[2] > open[2] and close > close[1] and close[1] > close[2] and open < close[1] and open[1] < close[2]
                _cp := "🪖 Three White Soldiers"
                _cs := "3 nến xanh liên tiếp đóng dần cao hơn — lực mua bền vững"
            else if close[1] < open[1] and close > open and math.abs(low - low[1]) / low[1] * 100 < 0.3
                _cp := "🔧 Tweezer Bottom"
                _cs := "Đáy hai nến gần bằng nhau — hỗ trợ giữ vững, khả năng bật"
            else if high < high[1] and low > low[1]
                _cp := "📦 Inside Bar"
                _cs := "Nến nằm trong nến trước tại hỗ trợ — chờ breakout tăng"
            else if close > open and _range > 0 and _body / _range >= 0.6
                _cp := "💚 Marubozu Tăng"
                _cs := "Nến tăng thân dài — tín hiệu tích cực"
        else if not isSuperStock
            if close[2] > open[2] and math.abs(close[1] - open[1]) <= math.abs(close[2] - open[2]) * 0.5 and close < open and close < (open[2] + close[2]) / 2
                _cp := "🌆 Evening Star"
                _cs := "3 nến đảo chiều giảm — phe bán kiểm soát sau phe mua kiệt sức"
            else if _body > 0 and _upWick >= 2 * _body and _dnWick <= 0.5 * _body
                _cp := "⭐ Shooting Star"
                _cs := "Đuôi dài trên — cảnh báo đảo chiều tại kháng cự"
            else if _body > 0 and _dnWick >= 2 * _body and _upWick <= 0.5 * _body
                _cp := "🪝 Hanging Man"
                _cs := "Đuôi dài dưới tại đỉnh — phe bán đang thăm dò"
            else if close < open and close[1] > open[1] and open >= close[1] and close <= open[1]
                _cp := "🕯️ Bearish Engulfing"
                _cs := "Nến giảm bao phủ nến tăng — xác nhận áp lực bán"
            else if close < open and close[1] > open[1] and open > close[1] and close < (open[1] + close[1]) / 2 and close > open[1]
                _cp := "🌧️ Dark Cloud Cover"
                _cs := "Nến giảm xuyên giữa nến tăng trước — tín hiệu đảo chiều giảm"
            else if _range > 0 and _body / _range < 0.1 and _upWick >= _dnWick * 1.5
                _cp := "🌃 Gravestone Doji"
                _cs := "Doji đuôi dài trên — cảnh báo đảo chiều giảm"
            else if _range > 0 and _body / _range < 0.15
                _cp := "〰️ Doji"
                _cs := "Giằng co tại kháng cự — chờ xác nhận"
            else if close < open and close[1] < open[1] and close[2] < open[2] and close < close[1] and close[1] < close[2] and open > close[1] and open[1] > close[2]
                _cp := "🪽 Three Black Crows"
                _cs := "3 nến đỏ liên tiếp đóng dần thấp hơn — áp lực bán bền vững"
            else if close[1] > open[1] and close < open and math.abs(high - high[1]) / high[1] * 100 < 0.3
                _cp := "🔧 Tweezer Top"
                _cs := "Đỉnh hai nến gần bằng nhau — kháng cự giữ vững, khả năng đảo chiều"
            else if high < high[1] and low > low[1]
                _cp := "📦 Inside Bar"
                _cs := "Nến nằm trong nến trước tại kháng cự — chờ breakout giảm"
            else if close < open and _range > 0 and _body / _range >= 0.6
                _cp := "🔴 Marubozu Giảm"
                _cs := "Nến giảm thân dài — áp lực bán lớn"
        if _cp != ""
            candlePatternTxt := "━━━━━━━━━━━━━━━━━━━━━━\n" +"🔥 Tín hiệu nến: " + _cp + "\n" +"   └ " + _cs
    if isSuperStock and trend == 1
        _ssQuote = buySignal ? "💎 Bứt phá đỉnh mới — Cơ hội vàng!\n   └ 'Great stocks make new highs, not new lows' — Minervini" :
                               "💎 Cổ phiếu liên tục lập đỉnh cao mới\n   └ 'Buy high, sell higher' — Mark Minervini"
        candlePatternTxt := candlePatternTxt + (candlePatternTxt != "" ? "\n" : "━━━━━━━━━━━━━━━━━━━━━━\n") + _ssQuote

    spinnerIndex = math.floor(timenow / 250) % 4
    spinner =
          spinnerIndex == 0 ? "◐" :
          spinnerIndex == 1 ? "◓" :
          spinnerIndex == 2 ? "◑" : "◒"
    superStockHdr = isSuperStock ?
         "💎 SIÊU CỔ PHIẾU — " + str.tostring(superScore) + "/7 tiêu chí\n" +
         "━━━━━━━━━━━━━━━━━━━━━━\n" : ""
    lblTxt = superStockHdr +
             "🤖 "  + " PHÂN TÍCH & KHUYẾN NGHỊ " + spinner+ " " + syminfo.ticker + "\n" +
             "━━━━━━━━━━━━━━━━━━━━━━"                                                               + "\n" +
             rsiTxt + "  " + macdTxt + "  " + adxTxt + "  " + obvTxt + "\n" +  emaTxt + "  " + vwapTxt    + "\n" +
             "Dòng vào: " + str.tostring(trend_buy_vol, format.volume) +
             " | Dòng ra: " + str.tostring(trend_sell_vol, format.volume) +
             " | Delta: " + deltaTxt + "\n" +
             "Vol/TB20 : " + volTxt                                                                         + "\n" +
             "Thanh khoản: " + str.tostring(close * volume / 1000000000, "#.##") + " tỷ/ngày | TB20: " + str.tostring(_ss_avgValue / 1000000000, "#.##") + " tỷ" + "\n" +
             "━━━━━━━━━━━━━━━━━━━━━━"                                                                             + "\n" +
             "⚡Sức mạnh: " + biasTextVN + " (" + str.tostring(math.round(biasNorm)) + "%)" + biasArrow      + "\n" + "\n" +
             (trend == 1 ? "💰 Xu hướng: Tăng" : "💸 Xu hướng: Giảm")                                        + "\n" +
             + profitTxt                                                                                      + "\n" +
             "💡 Action:  " + recTxt                                                                          + "\n" +
             candlePatternTxt                                                                                  + "\n" +
             "━━━━━━━━━━━━━━━━━━━━━━"
       

    lbVol := label.new(
         x         = last_bar_index + 1,
         y         = srAnchor,
         text      = lblTxt,
         style     = lblStyle,
         color     = trendClr,
         textcolor = color.white,
         size      = tSize,
         textalign = text.align_left,
         tooltip   = "ManhDucCapital-0973124824"
         )
// ===============================
// DISCLAIMER TABLE
// ===============================
var table tbDisclaimer = table.new(position.bottom_right, 1, 1)

if barstate.islast
    table.cell(
     tbDisclaimer, 
     0, 
     0, 
     "⚠️ Tín hiệu tham khảo - Quyết định đầu tư thuộc về bạn.", 
     text_color=color.gray,
     text_size=size.small)
// =========================================================
// CẢNH BÁO Vũ Mạnh Đức 0973124824
// =========================================================
alertcondition(buySignal,         "Cảnh báo vào trend",       "Cảnh báo vào trend!")
alertcondition(sellSignal,        "Cảnh báo hết trend",       "Cảnh báo hết trend!")
alertcondition(trend != trend[1], "Cảnh báo điểm Đảo chiều", "Cảnh báo điểm Đảo chiều!")